    $('#fileLink').hide();

    var myDropzone = new Dropzone("#theDropzoneForm", {

        dictDefaultMessage: "Drop a Revel CSV here to convert to Caternet XML",
        dictFallbackMessage: "Your browser does not support drag'n'drop file uploads.",
        dictFallbackText: "Please use the fallback form below to upload your files like in the olden days"
    });


    var d = new Date();
    var strDate = d.getFullYear() +  (d.getMonth() + 1) + d.getDate();

    myDropzone.on("success", function (file, data, xhr, test) {
        //data is reponse data - return URL
     
        $('#fileLink').text('Click here to view ' + file.name.split(/[ .]+/).filter(Boolean)[0] + ".xml, or right click and 'save as' to download");
        $('#fileLink').attr('href', "/CSV/Fourth/" + "latestCaternetXML.xml");
        $('#fileLink').show();


