    <body>
        <br />
        <br />
        <br />
        <div class="container">
            <div class="row">
                <div class="col-sm-10 col-sm-offset-1">
                    <form id="theForm" class="form-horizontal">
                        <div class="row">
                            <div class="col-sm-12">
                                <label for="FirstName">Name *</label>
                            </div>
                        </div>
                        <div class="row form-group">
                            <div class="col-sm-6">
                                <input type="text" class="form-control input-lg" id="FirstName" placeholder="e.g. Robert">
                                <small>First Name</small>
                                <br />
                            </div>
                            <div class="col-sm-6">
                                <input type="text" class="form-control input-lg" id="LastName" placeholder="e.g. Robertson">
                                <small>Last Name</small>
                            </div>
                        </div>
                        <div class="row form-group">
                            <div class="col-sm-12">
                                <label for="Email">Email address *</label>
                                <input type="email" class="form-control input-lg" id="Email" placeholder="e.g. robertrobertson@hotmail.com">
                            </div>
                        </div>
                        <div class="row form-group">
                            <div class="col-sm-12">
                                <label for="BlackCardNo">Black Card Number *</label>
                                <input type="text" class="form-control input-lg" id="BlackCardNo" placeholder="e.g. 00015671">
                            </div>
                        </div>
                        <div class="row form-group">
                            <div class="col-sm-12">
                                <label for="ConfirmBlackCardNo">Confirm Black Card Number *</label>
                                <input type="text" class="form-control input-lg" id="ConfirmBlackCardNo" placeholder="e.g. 00015671">
                            </div>
                        </div>
                        <br />
                        <div class="row form-group">
                            <div class="col-sm-12">
                                <button type="submit" class="btn btn-black">Submit</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
        <br />
        <br />
        <br />
    </body>

</html>


<script type="text/javascript">

    $(document).ready(function () {




        $("#theForm").on("submit", function (event) {          

            event.preventDefault();


            var cardNumber = $('#BlackCardNo').val();

            var email = $('#Email').val();
            var fname = $('#FirstName').val();
            var lname = $('#LastName').val();


            var model = {
                'number': cardNumber,
                'firstname': fname,
                'lastname': lname,
                'email': email,
                'dob': null,
                'establishment': '/enterprise/Establishment/6/'
            };

          
            $.ajax({
                type: "POST",
                dataType: "jsonp",
                url: 'http://localhost:45704/api/CusCard/',
                //url: 'http://grindandco.london.wisteria.arvixe.com/api/CusCard/',
                data: model,
                success: function (data) {
                    alert('Thank you for registering!');
                },
                error: function (error) {
                    alert('Sorry, your card was not created. Please check the fields and try again.');
                }
            });
        });


    });
</script>

