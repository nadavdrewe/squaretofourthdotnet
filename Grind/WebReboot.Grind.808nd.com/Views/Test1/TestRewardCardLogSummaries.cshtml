@model System.Collections.Generic.IEnumerable<Revel._808nd.com.Classes.Reporting.RewardCardLogPointsTotal>


@{
    ViewBag.Title = "Index";

}
@Html.Partial("~/PartialViews/BreadcrumbBarPartial.cshtml")


<div class="wrapper wrapper-content animated fadeInRight">
    <div class="row">

        <div class="col-lg-12">
            <div class="ibox float-e-margins">
                <div class="ibox-title">
                    <h5>@ViewBag.Title</h5>
                    <div class="ibox-tools">
                        <a class="collapse-link">
                            <i class="fa fa-chevron-up"></i>
                        </a>
                        <a class="dropdown-toggle" data-toggle="dropdown" href="#">
                            <i class="fa fa-wrench"></i>
                        </a>
                        <ul class="dropdown-menu dropdown-user">
                            <li>
                                <a href="#">Config option 1</a>
                            </li>
                            <li>
                                <a href="#">Config option 2</a>
                            </li>
                        </ul>
                        <a class="close-link">
                            <i class="fa fa-times"></i>
                        </a>
                    </div>
                </div>
                <div class="ibox-content">

                    <table class="table" id="example">

                        <thead>
                        <tr>
                            <th>
                                Date                               
                            </th>
                            <th>
                               Grind
                            </th>
                            <th>
                               Number Of Orders
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.NumberOfLogsAddingPoints)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.LogsAddingPointsAsPercentageOfOrders)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.TotalNumberOfPointsAdded)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.NumberOfLogsRedeemingPoints)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.LogsRedeemingPointsAsPercentageOfOrders)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.TotalNumberOfPointsRedeemed)
                            </th>
                        </tr>
                        </thead>

                        <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>

                                <td>
                                    @Html.DisplayFor(modelItem => item.DateTime)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Grind)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.NumberOfOrders)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.NumberOfLogsAddingPoints)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.LogsAddingPointsAsPercentageOfOrders)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.TotalNumberOfPointsAdded)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.NumberOfLogsRedeemingPoints)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.LogsRedeemingPointsAsPercentageOfOrders)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.TotalNumberOfPointsRedeemed)
                                </td>

                            </tr>

                        }

                    </table>
                </div>
            </div>
        </div>
    </div>
</div>


<script type="text/javascript">


    $(document).ready(function () {

        $('#example').DataTable(
{
    "pageLength": 50,
    "order": [[0, "desc"]],
    "deferRender": true,
    responsive: true,
    dom: '<"html5buttons"B>lTfgitp',
    buttons: [
           { extend: 'copy' },
           { extend: 'csv' },
           { extend: 'excel', title: '@ViewBag.Title' },
           { extend: 'pdf', title: '@ViewBag.Title' },

           {
               extend: 'print',
               customize: function (win) {
                   $(win.document.body).addClass('white-bg');
                   $(win.document.body).css('font-size', '10px');

                   $(win.document.body).find('table')
                           .addClass('compact')
                           .css('font-size', 'inherit');
               }
           }
    ]
}
);


        $('#message').fadeIn(2000);
        $('#message').delay(2000);
        $('#message').fadeOut(2000);

    });



</script>