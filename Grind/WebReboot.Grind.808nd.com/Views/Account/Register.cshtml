@model Web.Grind._808nd.com.Models.RegisterViewModel
@{
    ViewBag.Title = "Register";
}

@Html.Partial("~/PartialViews/BreadcrumbBarPartial.cshtml")

<div class="middle-box text-center loginscreen   animated fadeInDown">
    <div>
        <div>

            <h1 class="logo-name">G</h1>

        </div>
        <h3>Register a Grind Account</h3>
        <p>Create a new account here and it will be working immediately</p>

        @using (Html.BeginForm("Register", "Account", FormMethod.Post, new { @class = "m-t", role = "form" }))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary()

            <div class="form-group">
                @Html.TextBoxFor(m => m.UserName, new { @placeholder = "Email (this will be your username)", @type = "email", @class = "form-control email" })
            </div>
            <div class="form-group">
                @Html.PasswordFor(m => m.Password, new { @placeholder = "Password", @type = "password", @class = "form-control password" })
            </div>
            <div class="form-group">
                @Html.PasswordFor(m => m.ConfirmPassword, new { @placeholder = "Confirm", @class = "form-control" })
            </div>
            @*  <div class="form-group">
                    <div class="checkbox i-checks"><label> <input type="checkbox"><i></i> Agree the terms and policy </label></div>
                </div>*@
            <button type="submit" class="btn btn-primary block full-width m-b">Register</button>

            <p class="text-muted text-center">
                <small>Already have an account?</small>
            </p>
            <a class="btn btn-sm btn-white btn-block" href="~/Account/Login">Login</a>
        }


     


        <p class="m-t"> <small>Grind &copy; 2016</small> </p>
    </div>
</div>


