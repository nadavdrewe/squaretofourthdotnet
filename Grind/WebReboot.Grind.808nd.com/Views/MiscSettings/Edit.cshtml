@model Revel._808nd.com.Classes.MiscSettings

@{
    ViewBag.Title = "Misc Grind Settings";
}
@Html.Partial("~/PartialViews/BreadcrumbBarPartial.cshtml")



<div class="wrapper wrapper-content animated fadeInRight">
    <div class="row">

        <div class="col-lg-12">
            <div class="ibox float-e-margins">
                <div class="ibox-title">
                    <h5>@ViewBag.Title</h5>
                    <div class="ibox-tools">
                        <a class="collapse-link">
                            <i class="fa fa-chevron-up"></i>
                        </a>
                        <a class="dropdown-toggle" data-toggle="dropdown" href="#">
                            <i class="fa fa-wrench"></i>
                        </a>
                        <ul class="dropdown-menu dropdown-user">
                            <li>
                                <a href="#">Config option 1</a>
                            </li>
                            <li>
                                <a href="#">Config option 2</a>
                            </li>
                        </ul>
                        <a class="close-link">
                            <i class="fa fa-times"></i>
                        </a>
                    </div>
                </div>
                <div class="ibox-content">

                    <h2>Late Reporting</h2>

                    @using (Html.BeginForm())
                    {
                        @Html.AntiForgeryToken()

                        <div class="form-horizontal">
                            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                            @Html.HiddenFor(model => model.Id)

                            <div class="form-group">

                                <label class="control-label col-md-2">Late Stored Notifiers Active?</label>
                                <div class="col-md-10">
                                    <div class="checkbox" style="padding-left:20px">
                                        @Html.EditorFor(model => model.LateOpeningStoreNotifier)
                                        @Html.ValidationMessageFor(model => model.LateOpeningStoreNotifier, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                            </div>

                            <div class="form-group">
                                <label class="control-label col-md-2">Late minutes window after opening</label>
                                <div class="col-md-10">
                                    @Html.EditorFor(model => model.LateOpeningStoreMinutesWindow, new { htmlAttributes = new { @class = "form-control" } })
                                    @Html.ValidationMessageFor(model => model.LateOpeningStoreMinutesWindow, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="form-group">
                                <label class="control-label col-md-2">Run late report now</label>
                                <div class="col-md-10">
                                    <button type="button" class="btn btn-outline btn-success" onclick="location.href = '@Html.Action("CheckIfAllStoresHaveOpenedLate", "OpeningHours")';">Run report</button>
                                </div>
                            </div>

                            <div class="form-group">
                                <div class="col-md-offset-2 col-md-10">
                                    <input type="submit" value="Save" class="btn btn-default" />
                                </div>
                            </div>
                        </div>
                    }





                </div>

            </div>

        </div>
    </div>
</div>







