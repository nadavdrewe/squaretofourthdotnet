@using System.Activities.Statements
@using Revel._808nd.com.Classes;
@using Web.Grind._808nd.com.Controllers

@model Revel._808nd.com.Classes.RewardsCardNew

@{
    ViewBag.Title = "Create Card";

    var Customer = (Customer)ViewBag.Customer;



    AjaxOptions options = new AjaxOptions
    {
        InsertionMode = InsertionMode.Replace,
        LoadingElementId = "spinner"


    };
    var insertUser = ViewBag.RevelCardInsertUser;
    var loyaltyDropdown = ViewBag.DropdownCardType as List<SelectListItem>;
}


@Html.Partial("~/PartialViews/BreadcrumbBarPartial.cshtml")


<div class="wrapper wrapper-content animated fadeInRight">
    <div class="row">

        <div class="row">
            <div class="col-lg-12">
                <div class="ibox float-e-margins">
                    <div class="ibox-title">
                        <h5>Create a New Card</h5>
                        <div class="ibox-tools">
                            <a class="collapse-link">
                                <i class="fa fa-chevron-up"></i>
                            </a>
                            <a class="dropdown-toggle" data-toggle="dropdown" href="#">
                                <i class="fa fa-wrench"></i>
                            </a>
                            <ul class="dropdown-menu dropdown-user">
                                <li>
                                    <a href="#">Config option 1</a>
                                </li>
                                <li>
                                    <a href="#">Config option 2</a>
                                </li>
                            </ul>
                            <a class="close-link">
                                <i class="fa fa-times"></i>
                            </a>
                        </div>
                    </div>
                    <div class="ibox-content">
                        @using (Html.BeginForm("Create", "CombinedCardCustomer", FormMethod.Post, new { @id = "frmId", @class = "form-inline" }))
