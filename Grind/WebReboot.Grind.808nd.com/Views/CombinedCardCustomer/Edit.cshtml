@{
    var loyaltyId = Model.LoyaltyCardType != null ? Model.LoyaltyCardType.id : 0;
}
<script type="text/javascript">

    function getLatestCardLogs() {

        console.log("now getting latest card Logs");
        $.ajax({
            url: '@Url.Action("GetCardLogs", "CombinedCardCustomer")',
            type: 'POST',
            cache: false,
            data: { id: '@Model.DBKEY_rewardscardnew_id' },
            success: function (result) {
                $('#logSpace').html(result);

            }


        });
    }





    $(document).ready(function () {

                
        $('#RefreshableCardType').val('@LoyaltyCardAdaptorUIService.GetUICardType(Model)');

        $('#is_vip_card').val('@Model.is_vip_card');
        $('#LoyaltyCardType_id').val('@loyaltyId');
        $('#establishment').val('@Model.establishment');

        console.log('@Model.Customer.BirthDate');

        $('#datepicker').datepicker({ dateFormat: 'dd/MM/yyyy ' });

        $('#RewardsCardNew.ExpiryDate').val('@Model.ExpiryDate');
        $('#active').val('@Model.Active');

        getLatestCardLogs();

    });
</script>

