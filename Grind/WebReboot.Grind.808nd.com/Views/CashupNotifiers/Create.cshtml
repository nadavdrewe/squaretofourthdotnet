@model Revel._808nd.com.Classes.CashupNotifier

@{
    ViewBag.Title = "Create Cashup Notification";
}
@Html.Partial("~/PartialViews/BreadcrumbBarPartial.cshtml")



<div class="wrapper wrapper-content animated fadeInRight">
    <div class="row">

        <div class="col-lg-12">
            <div class="ibox float-e-margins">
                <div class="ibox-title">
                    <h5>@ViewBag.Title</h5>
                    <div class="ibox-tools">
                        <a class="collapse-link">
                            <i class="fa fa-chevron-up"></i>
                        </a>
                        <a class="dropdown-toggle" data-toggle="dropdown" href="#">
                            <i class="fa fa-wrench"></i>
                        </a>
                        <ul class="dropdown-menu dropdown-user">
                            <li>
                                <a href="#">Config option 1</a>
                            </li>
                            <li>
                                <a href="#">Config option 2</a>
                            </li>
                        </ul>
                        <a class="close-link">
                            <i class="fa fa-times"></i>
                        </a>
                    </div>
                </div>
                <div class="ibox-content">

                    @using (Html.BeginForm())
                    {
                        @Html.AntiForgeryToken()

                        <div class="form-horizontal">
                           
                        
                            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                            <div class="form-group">
                                <label class="control-label col-md-2">Notification Address</label>
                               <div class="col-md-4">
                                    @Html.EditorFor(model => model.NotificationAddress, new {htmlAttributes = new {@class = "form-control"}})
                                    @Html.ValidationMessageFor(model => model.NotificationAddress, "", new {@class = "text-danger"})
                                </div>
                            </div>

                            <div class="form-group">
                                <label class="control-label col-md-2">Grind</label>
                              
                                <div class="col-md-4">
                                    @Html.DropDownList("DBKEY_establishment_id", null, htmlAttributes: new {@class = "form-control"})
                                    @Html.ValidationMessageFor(model => model.DBKEY_establishment_id, "", new {@class = "text-danger"})
                                </div>
                            </div>

                            <div class="form-group">
                                <label class="control-label col-md-2">Enabled</label>
                               
                                <div class="col-md-10">
                                    <div class="checkbox">
                                        @Html.EditorFor(model => model.Enabled)
                                        @Html.ValidationMessageFor(model => model.Enabled, "", new {@class = "text-danger"})
                                    </div>
                                </div>
                            </div>

                            <div class="form-group">
                                <label class="control-label col-md-2">Universal Contact</label>
                             
                                <div class="col-md-10">
                                    <div class="checkbox">
                                        @Html.EditorFor(model => model.UniversalContact)
                                        @Html.ValidationMessageFor(model => model.UniversalContact, "", new {@class = "text-danger"})
                                    </div>
                                </div>
                            </div>

                            <div class="form-group">
                                <div class="col-md-offset-2 col-md-10">
                                    <input type="submit" value="Create" class="btn btn-default" />
                                </div>
                            </div>
                        </div>
                    }

                </div>
            </div>
        </div>
    </div>
</div>
