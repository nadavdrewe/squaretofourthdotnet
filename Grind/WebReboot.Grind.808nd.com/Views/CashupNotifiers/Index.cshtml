@model IEnumerable<Revel._808nd.com.Classes.CashupNotifier>

@{
    ViewBag.Title = "Cashup Notification Index";
}


@Html.Partial("~/PartialViews/BreadcrumbBarPartial.cshtml")

<div class="wrapper wrapper-content animated fadeInRight">
    <div class="row">

        <div class="col-lg-12">
            <div class="ibox float-e-margins">
                <div class="ibox-title">
                    <h5>@ViewBag.Title</h5>
                    <div class="ibox-tools">
                        <a class="collapse-link">
                            <i class="fa fa-chevron-up"></i>
                        </a>
                        <a class="dropdown-toggle" data-toggle="dropdown" href="#">
                            <i class="fa fa-wrench"></i>
                        </a>
                        <ul class="dropdown-menu dropdown-user">
                            <li>
                                <a href="#">Config option 1</a>
                            </li>
                            <li>
                                <a href="#">Config option 2</a>
                            </li>
                        </ul>
                        <a class="close-link">
                            <i class="fa fa-times"></i>
                        </a>
                    </div>
                </div>
                <div class="ibox-content">
                    <table class="table">
                        <tr>
                            <th>
                                Grind
                            </th>
                            <th>
                                Notification Address
                            </th>
                            <th>
                                Enabled
                            </th>
                            <th>
                                Universal Contact
                            </th>
                            <th></th>
                        </tr>

                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Establishment.name)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.NotificationAddress)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Enabled)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.UniversalContact)
                                </td>
                                <td>
                                    @Html.ActionLink("Edit", "Edit", new { id = item.Id }) |
                                  @Html.ActionLink("Delete", "Delete", new { id = item.Id })
                                </td>
                            </tr>
                        }

                    </table>

                </div>
            </div>
        </div>
    </div>
</div>

