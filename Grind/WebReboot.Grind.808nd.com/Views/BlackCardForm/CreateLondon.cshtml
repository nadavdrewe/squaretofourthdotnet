    <div class="container" id="mainContainer">
        <div class="row">
            <div class="col-sm-10 col-sm-offset-1">
                <form id="theForm" class="form-horizontal">
                    <div class="row">
                        <div class="col-sm-12">
                            <label for="FirstName">Name *</label>
                        </div>
                    </div>
                    <div class="row form-group">
                        <div class="col-sm-6">
                            <input type="text" class="form-control input-lg" id="FirstName" placeholder="e.g. Robert" required>
                            <small>First name</small>
                            <br />
                        </div>
                        <div class="col-sm-6">
                            <input type="text" class="form-control input-lg" id="LastName" placeholder="e.g. Robertson" required>
                            <small>Last name</small>
                        </div>
                    </div>
                    <div class="row form-group">
                        <div class="col-sm-12">
                            <label for="DOB">DOB *</label>
                            <input type="date" class="form-control input-lg" id="DOB" placeholder="e.g. 11/12/1982">
                        </div>
                    </div>
                    <div class="row form-group">
                        <div class="col-sm-12">
                            <label for="Email">Email address *</label>
                            <input type="email" class="form-control input-lg" id="Email" placeholder="e.g. robertrobertson@hotmail.com" required>
                        </div>
                    </div>
                    <div class="row form-group">
                        <div class="col-sm-12">
                            <label for="BlackCardNo">Black Card Number *</label>
                            <input type="text" class="form-control input-lg BlackCardNo" id="BlackCardNo" placeholder="e.g. 00015671" required name="BlackCardNo">
                        </div>
                    </div>
                    <div class="row form-group">
                        <div class="col-sm-12">
                            <label for="ConfirmBlackCardNo">Confirm Black Card Number *</label>
                            <input type="text" class="form-control input-lg " id="ConfirmBlackCardNo" placeholder="e.g. 00015671" required name="ConfirmBlackCardNo" data-rule-equalto="input[name=BlackCardNo]" data-msg-required="Please confirm your black card number" data-msg-equalto="Card numbers do not match">
                        </div>
                    </div>
                    <br />
                    <div class="row form-group">
                        <div class="col-sm-12">
                            <button type="submit" class="btn btn-black">Submit</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <br />
    <br />
    <br />
</body>

