    $(document).ready(function () {

        /*        jQuery.validator.addMethod("idRule", function(value, element) {
                    return this.optional(element) || (array.indexOf(value) > 0);
                }, "Please use a number that doesn't exist");*/



        /*        $.validator.addMethod("idRule", validateID, "Please use a number that doesn't exist");     */

        var form = $("#theForm");

        form.validate(
        {
            /* rules: {
                 BlackCardNo: {
                     idRule: true
                 }
             },
             messages: {
                 BlackCardNo: "Entered ID already exists",

             },*/
            ConfirmBlackCardNo: {
                equalTo: '#BlackCardNo',
                ignore: ".ignore"
            }

        });


        $("button").click(function () {
            form.valid();
            //   $('.error').addClass('popover-content');
        });





        $("#theForm").on("submit", function (event) {

            if ($("#theForm").valid()) {

                event.preventDefault();


                var cardNumber = $('#BlackCardNo').val();

                var email = $('#Email').val();
                var fname = $('#FirstName').val();
                var lname = $('#LastName').val();
                var dob = $("#DOB").val();

                var model = {
                    'number': cardNumber,
                    'firstname': fname,
                    'lastname': lname,
                    'email': email,
                    'dob': dob,
                    'establishment': '/enterprise/Establishment/4/'
                };


                $.ajax({
                    type: "POST",
                    dataType: "jsonp",
                    //url: 'http://localhost:3633/BlackCardForm/Create',
                    url: 'http://46.231.116.202:80/BlackCardForm/Create',
                    data: model,

                    success: function (data) {
                        $('div#mainContainer').html("<div align='center'><h2>Thank you for registering your black card, it will be active immediately.</h2><h2>Don’t forget to use your card each time you visit.</h2></div>");
                        $('body').css('height', '200px');
                    },

                 
                    error: function (xhr, ajaxOptions, thrownError) {
                        alert(xhr.status);
                        alert(thrownError);
                        $('div#mainContainer').html("<div align='center'><h2>Sorry that didn't work. Please check your black card number and try again later.</h2></div>");
                        $('body').css('height', '200px');
                    }
                });

            }
        });



    });
</script>
