@using System.Web.Mvc.Html
@using Revel._808nd.com.Classes
@model Revel._808nd.com.ReportingModel.ProductWatch

@{
    ViewBag.Title = "Create Product Watch";
    var ests = ViewBag.EstablishmentsSelect as List<SelectListItem>;
    var listOfEstablishments = ViewBag.Establishments as List<Establishment>;


    var ajaxOptions = new AjaxOptions
    {
        UpdateTargetId = "resultDiv",
        HttpMethod = "POST",
        InsertionMode = InsertionMode.Replace

    };

}

@Html.Partial("~/PartialViews/BreadcrumbBarPartial.cshtml")



<div class="wrapper wrapper-content animated fadeInRight">
    <div class="row">
       
        <div class="col-lg-12">
            <div class="ibox float-e-margins">
                <div class="ibox-title">
                    <h5>@ViewBag.Title</h5>
                    <div class="ibox-tools">
                        <a class="collapse-link">
                            <i class="fa fa-chevron-up"></i>
                        </a>
                        <a class="dropdown-toggle" data-toggle="dropdown" href="#">
                            <i class="fa fa-wrench"></i>
                        </a>
                        <ul class="dropdown-menu dropdown-user">
                            <li>
                                <a href="#">Config option 1</a>
                            </li>
                            <li>
                                <a href="#">Config option 2</a>
                            </li>
                        </ul>
                        <a class="close-link">
                            <i class="fa fa-times"></i>
                        </a>
                    </div>
                </div>
                <div class="ibox-content">

                    @using (Ajax.BeginForm("GetProductsForEstablishment", "ProductWatches", ajaxOptions))
                    {
                        @Html.AntiForgeryToken()


                    
                        <div class="row">
                            <div class="panel panel-dark-gray panel-dark">
                                <div class="panel-heading">
                                    <span class="panel-title">Create New Watch</span>
                                </div>
                                <div class="panel-body">
                                    <div class="form-block">

                                        <hr />
                                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                                        <div>
                                            <label class="control-label col-md-2">Which Grind?</label>
                                            <div class="col-md-4">
                                                @Html.DropDownList("EstablishmentID", ests,  new { @class = "form-control"  })
                                                @Html.ValidationMessageFor(model => model.Revel_Product_Id, "", new { @class = "text-danger" })
                                            </div>
                                        </div>
                                        <div class="form-group">
                                            <div class="col-md-offset-2 col-md-10">
                                                <input type="submit" value="Show Products" class="btn btn-primary" />
                                            </div>
                                        </div>
                                    </div>


                                    <div id="resultDiv" name="resultDiv">

                                    </div>

                                 
                                </div>
                            </div>
                        </div>
                    }


                </div>
            </div>
        </div>
    </div>
</div>
