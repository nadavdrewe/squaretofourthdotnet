@model IEnumerable<Revel._808nd.com.Classes.SystemLog>

@{
    ViewBag.Title = "System Log Index";
}
@Html.Partial("~/PartialViews/BreadcrumbBarPartial.cshtml")



<div class="wrapper wrapper-content animated fadeInRight">
    <div class="row">

        <div class="col-lg-12">
            <div class="ibox float-e-margins">
                <div class="ibox-title">
                    <h5>@ViewBag.Title</h5>
                    <div class="ibox-tools">
                        <a class="collapse-link">
                            <i class="fa fa-chevron-up"></i>
                        </a>
                        <a class="dropdown-toggle" data-toggle="dropdown" href="#">
                            <i class="fa fa-wrench"></i>
                        </a>
                        <ul class="dropdown-menu dropdown-user">
                            <li>
                                <a href="#">Config option 1</a>
                            </li>
                            <li>
                                <a href="#">Config option 2</a>
                            </li>
                        </ul>
                        <a class="close-link">
                            <i class="fa fa-times"></i>
                        </a>
                    </div>
                </div>
                <div class="ibox-content">
                    <p>
                        @Html.ActionLink("Create New", "Create")
                    </p>
                    <table class="table" id="example">
                        <thead>
                            <tr>
                                <th>
                                    @Html.DisplayNameFor(model => model.Type)
                                </th>
                                <th>
                                    @Html.DisplayNameFor(model => model.Note)
                                </th>
                                <th>
                                    @Html.DisplayNameFor(model => model.WhoTriggered)
                                </th>
                                <th>
                                    @Html.DisplayNameFor(model => model.WhenCreated)
                                </th>
                                <th></th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.Type)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.Note)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.WhoTriggered)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.WhenCreated)
                                    </td>
                                    <td>
                                     @*   @Html.ActionLink("Edit", "Edit", new { id = item.Id }) |
                                        @Html.ActionLink("Details", "Details", new { id = item.Id }) |
                                        @Html.ActionLink("Delete", "Delete", new { id = item.Id })*@
                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>


                </div>

            </div>

        </div>
    </div>
</div>



<script type="text/javascript">


    $(document).ready(function () {
        $('#example').DataTable(
        {
            "pageLength": 50,
            "scrollX": true,
            responsive: true
        }
        );


        $('#message').fadeIn(2000);
        $('#message').delay(2000);
        $('#message').fadeOut(2000);

    });



</script>


