@using Microsoft.AspNet.Identity
@using System.Security.Claims;

@{
    var userRole = "";

    if (User.Identity.IsAuthenticated)
    {
        userRole = ((ClaimsIdentity)User.Identity).Claims
            .Where(c => c.Type == ClaimTypes.Role)
            .Select(c => c.Value).First().ToString();
    }

}
