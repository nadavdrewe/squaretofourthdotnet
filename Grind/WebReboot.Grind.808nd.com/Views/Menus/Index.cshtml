@using Revel._808nd.com.Classes
@using Revel._808nd.com.Models.ViewModels
@model IEnumerable<Revel._808nd.com.Classes.Menu>

@{
    ViewBag.Title = "Menu Index";
    List<MenuFileDTO> files = (List<MenuFileDTO>)ViewBag.Files;

    var meus = (List<SelectListItem>)ViewBag.MenuTypes;
    var est = (List<SelectListItem>)ViewBag.Establishments;

    var ests = (List<Establishment>)ViewBag.Estabs;

    var permissions = (List<MenuPermissions>)ViewBag.MenuPermissions;

}



@Html.Partial("~/PartialViews/BreadcrumbBarPartial.cshtml")

<div class="wrapper wrapper-content animated fadeInRight">
    <div class="row">

        <div class="col-lg-12">
            <div class="ibox float-e-margins">
                <div class="ibox-title">
                    <h5>@ViewBag.Title</h5>
                    <div class="ibox-tools">
                        <a class="collapse-link">
                            <i class="fa fa-chevron-up"></i>
                        </a>
                        <a class="dropdown-toggle" data-toggle="dropdown" href="#">
                            <i class="fa fa-wrench"></i>
                        </a>
                        <ul class="dropdown-menu dropdown-user">
                            <li>
                                <a href="#">Config option 1</a>
                            </li>
                            <li>
                                <a href="#">Config option 2</a>
                            </li>
                        </ul>
                        <a class="close-link">
                            <i class="fa fa-times"></i>
                        </a>
                    </div>
                </div>
                <div class="ibox-content">

                    <p>
                        @Html.ActionLink("Create New", "Create")
                    </p>

                    <h5 style="color:red">To link: http://app.grindandco.com/menus/show/{id} - e.g. http://app.grindandco.com/menus/show/2 </h5>

                    <div id="tabs">

                        <ul>

                            @foreach (var e in ests)
            {
                                <li><a href="#tabs-@e.establishment_id">@e.name</a></li>
                            }

                        </ul>

                        @foreach (var e in ests)
                        {
                            <div id="tabs-@e.establishment_id">

                                <table class="table" id="example">
                                    <thead>
                                        <tr>
                                            <th>
                                                Grind
                                            </th>
                                            <th>
                                                Type
                                            </th>
                                            <th>
                                                Date
                                            </th>
                                            <th>
                                                Uploaded By
                                            </th>
                                            <th>Permalink</th>
                                            <th>Links</th>
                                            <th></th>
                                        </tr>
                                    <thead>

                                    <tbody>
                                        @foreach (var item in Model.Where(x => x.Establishment.establishment_id == e.establishment_id))
                                        {

                                            <tr>
                                                <td>
                                                    @Html.DisplayFor(modelItem => item.Establishment.name)
                                                </td>
                                                <td>
                                                    @Html.DisplayFor(modelItem => item.MenuType.name)
                                                </td>
                                                <td>
                                                    @Html.DisplayFor(modelItem => item.WhenCreated)
                                                </td>
                                                <td>
                                                    @Html.DisplayFor(modelItem => item.WhoUploaded)
                                                </td>
                                                <td>
                                                    @{
                                                        var link = "http://app.grindandco.com/menu/" + @item.Establishment.name.ToLower() + "/" + @item.MenuType.name.ToLower();
                                                    }
                                                    <a href="@link">@link</a>
                                                </td>
                                                <td>
                                                    @if (files != null)
                    {
                        foreach (var file in files)
                        {
                            if (file.menuid == item.id)
                            {
                                                                @Html.Raw(file.extension + "<span style='color: red'> ID:" + file.id + "</span>")
                                                                @Html.Raw(" - ")
                                                                @Html.ActionLink("Show", "Show", "Menus", new { id = file.id, type = "show" }, new { target = "_blank" })
                                                                @Html.Raw(" | ")
                                                                @Html.ActionLink("Download ", "Show", new { id = file.id, type = "download" })

                                                            }
                                                        }
                                                    }
                                                </td>
                                                <td>
                                                    @* @Html.ActionLink("Show", "Show", "Menus", new { id = item.id, extension = "", type = "show" }, new { target = "_blank" }) |
                                                            @Html.ActionLink("Download Menu", "Show", new { id = item.id, extension = "" }) |
                                                            @Html.ActionLink("Download Indesign", "Show", new { id = item.id, extension = ".indd"}) |
                                                        @Html.ActionLink("Edit", "Edit", new { id = item.id }) |*@
                                             @*       @Html.ActionLink("Details", "Details", new { id = item.id }) |*@
                                                    @Html.ActionLink("Delete", "Delete", new { id = item.id })
                                                </td>
                                            </tr>
                                                        }
                                    <tbody>
                                </table>
                            </div>
                                                        }
                        @* <div id="tabs-@e.establishment_id">
                               test
                            </div>
                            <div id="tabs-2">
                                test
                            </div>
                            <div id="tabs-3">
                                test
                            </div>
                            <div id="tabs-4">
                                test
                            </div>
                            <div id="tabs-5">
                                test
                            </div>
                            <div id="tabs-6">
                                test
                            </div>*@

                    </div>

                </div>
            </div>
        </div>
    </div>
</div>


<script>

    $(document).ready(function () {
        $('.table').DataTable(
        {
            "pageLength": 50,
            "order": [[0, "desc"]],
            "scrollX": true,
            responsive: true
        }
        );


        $('#message').fadeIn(2000);
        $('#message').delay(2000);
        $('#message').fadeOut(2000);

    });



    $(document).ready(function () {

        // Handler for .ready() called.
        $(function () {
            $("#tabs").tabs();

            var currentSetPage = sessionStorage.getItem('currentTab');

            $("#tabs").tabs("option", "active", currentSetPage);


        });

        $('.SheetSelector').change(function (e) {

            //get all vars

            var id = this.value;
            /*alert(id);*/
            var currentPage = $("#tabs").tabs('option', 'active');

            if (currentPage == undefined || currentPage === "") {

                currentPage = 0;
            }
            sessionStorage.setItem('currentTab', currentPage);

            //request
            $.ajax({
                url: '/Home/OpenXLSFile',
                data: { "filename": id },
                type: "POST",
                success: function (result) {
                    location.reload(true);
                    //get the pricing
                },
                error: function () { alert('That did not work please try again'); }
            });

        });

    });
</script>
