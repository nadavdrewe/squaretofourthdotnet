@using Revel._808nd.com.Classes
@using WebReboot.Grind._808nd.com.Models.ViewModels
@model EstablishmentMenuPermissionViewModel

@{
    ViewBag.Title = "Create New Menu";

    var meus = (List<SelectListItem>)ViewBag.MenuTypes;

    var establishmentMenuPermissions = (List<EstablishmentMenuPermissionViewModel>)ViewBag.EstablishmentMenuPermissionsViewModel;

    var est = (List<SelectListItem>)ViewBag.Establishments;

    var ests = (List<Establishment>)ViewBag.Estabs;




}


@Html.Partial("~/PartialViews/BreadcrumbBarPartial.cshtml")

<div class="wrapper wrapper-content animated fadeInRight">
    <div class="row">

        <div class="col-lg-12">
            <div class="ibox float-e-margins">
                <div class="ibox-title">
                    <h5>@ViewBag.Title</h5>
                    <div class="ibox-tools">
                        <a class="collapse-link">
                            <i class="fa fa-chevron-up"></i>
                        </a>
                        <a class="dropdown-toggle" data-toggle="dropdown" href="#">
                            <i class="fa fa-wrench"></i>
                        </a>
                        <ul class="dropdown-menu dropdown-user">
                            <li>
                                <a href="#">Config option 1</a>
                            </li>
                            <li>
                                <a href="#">Config option 2</a>
                            </li>
                        </ul>
                        <a class="close-link">
                            <i class="fa fa-times"></i>
                        </a>
                    </div>
                </div>
                <div class="ibox-content">

                    <h2>Create New Menu</h2>

                    <script type="text/javascript">

                        $(document).ready(function () {
                            $(".dz-message").find("span").each(function () { this.html('Click here to upload') });
                        });


                    </script>


                    @Scripts.Render("~/bundles/dropzonescripts")
                    @Styles.Render("~/bundles/dropzonecss")


                    <h4>Media</h4>


                    <div class="form-horizontal">
                        <form action="~/Menus/Upload" method="post" enctype="multipart/form-data" class="dropzone" id="dropzoneForm" style="background: none; border: none; text-align: center">
                            <div class="fallback">
                                <input name="file" type="file" multiple />
                                <input type="submit" value="Upload" />
                            </div>
                        </form>
                    </div>

                    @*Tabs*@

                    <div class="tabs-container">
                        <ul class="nav nav-tabs">

                            @{
                                var currentCount = 0;
                            }
                            @foreach (var e in ests)
                            {
                                var tabActive = "";
                                if (currentCount == 0)
                                {
                                    tabActive = "active";
                                }

                                <li id="tab-header-@e.establishment_id" class='@tabActive'><a id="tab-anchor-@e.establishment_id" data-toggle="tab" href='#tab-@e.establishment_id' aria-expanded="true">@e.name</a></li>

                                currentCount++;
                            }
                        </ul>
                        <div class="tab-content">
                            @{
                                var currentCount2 = 0;
                                var tabActive2 = "";
                                if (currentCount2 == 0)
                                {
                                    tabActive2 = "active";
                                }

                                foreach (var e in ests)
                                {
                                    <div id="tab-@e.establishment_id" class="tab-pane @tabActive2">
                                        <div class="panel-body">
                                            <strong>@e.name</strong>

                                            <div>
                                                @{
                                                    var allowed = establishmentMenuPermissions.Where(x => x.Establishment_Id == e.establishment_id).ToList();


                                                    var ddl = allowed.Select(menu => new SelectListItem
                                                    {
                                                        Text = menu.MenuTypeName,
                                                        Value = Convert.ToString(menu.MenuTypeId)

                                                    }).ToList();

                                                }
                                                ..this menu is for <span style="color:red">@e.name</span>
                                                and is of type:



                                                @using (Html.BeginForm())
                                                {
                                                    @Html.AntiForgeryToken()
                                                    @Html.Hidden("Establishment_Id", e.establishment_id)



                                                    <div class="form-group">
                                                        <div class="col-lg-3">
                                                            @Html.DropDownList("MenuTypeId", ddl, new { @class = "form-control" })
                                                        </div>
                                                        <input type="submit" value="Create" class="btn btn-default" />
                                                    </div>
                                                    <div class="form-group">



                                                    </div>

                                                }


                                            </div>
                                        </div>
                                    </div>
                                                        currentCount2++;
                                                    }

                            }

                        </div>


                    </div>








                    @*     <div id="tabs">

                            <ul>

                                @foreach (var e in ests)
                                {
                                    <li><a href="#tabs-@e.establishment_id">@e.name</a></li>
                                }

                            </ul>



                            @foreach (var e in ests)
                            {

                                <div id="tabs-@e.establishment_id">

                                     <div>
                                        @{
                                            var allowed = establishmentMenuPermissions.Where(x => x.Establishment_Id == e.establishment_id).ToList();


                                            var ddl = allowed.Select(menu => new SelectListItem
                                            {
                                                Text = menu.MenuTypeName,
                                                Value = Convert.ToString(menu.MenuTypeId)

                                            }).ToList();

                                        }
                                        ..this menu is for <span style="color:red">@e.name</span>
                                        and is of type:



                                        @using (Html.BeginForm())
                                        {
                                            @Html.AntiForgeryToken()
                                            @Html.Hidden("Establishment_Id", e.establishment_id)



                                            <div class="form-group">

                                                @Html.DropDownList("MenuTypeId", ddl, new { htmlAttributes = new { @class = "form-control" } })
                                                <input type="submit" value="Create" class="btn btn-default" />
                                            </div>
                                            <div class="form-group">



                                            </div>

                                        }


                                    </div>

                                </div>
                                            }




                        </div>
                    *@


                    <div>
                        @Html.ActionLink("Back to List", "Index")
                    </div>


                </div>
            </div>
        </div>
    </div>
</div>


