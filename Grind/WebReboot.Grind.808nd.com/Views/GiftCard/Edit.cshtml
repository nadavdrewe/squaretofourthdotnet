@model Revel._808nd.com.Classes.GiftCard

@{
    ViewBag.Title = "Gift Card Edit";
}

@Html.Partial("~/PartialViews/BreadcrumbBarPartial.cshtml")


<div class="wrapper wrapper-content animated fadeInRight">
    <div class="row">

        <div class="col-lg-12">
            <div class="ibox float-e-margins">
                <div class="ibox-title">
                    <h5>@ViewBag.Title</h5>
                    <div class="ibox-tools">
                        <a class="collapse-link">
                            <i class="fa fa-chevron-up"></i>
                        </a>
                        <a class="dropdown-toggle" data-toggle="dropdown" href="#">
                            <i class="fa fa-wrench"></i>
                        </a>
                        <ul class="dropdown-menu dropdown-user">
                            <li>
                                <a href="#">Config option 1</a>
                            </li>
                            <li>
                                <a href="#">Config option 2</a>
                            </li>
                        </ul>
                        <a class="close-link">
                            <i class="fa fa-times"></i>
                        </a>
                    </div>
                </div>
                <div class="ibox-content">

                    @using (Html.BeginForm())
                    {
                        @Html.AntiForgeryToken()

                        <h4>Please edit the card</h4>

                        <div class="form-horizontal">

                            <hr />
                            @Html.ValidationSummary(true)

                            @Html.HiddenFor(model => model.created_by, new { id = "created_by", @Name = "created_by", Value = @Model.created_by })
                            @Html.HiddenFor(model => model.created_date, new { id = "created_date", @Name = "created_date", Value = @Model.created_date })
                            @Html.HiddenFor(model => model.updated_date, new { id = "updated_date", @Name = "updated_date", Value = @Model.updated_date })
                            @Html.HiddenFor(model => model.updated_by, new { id = "updated_by", @Name = "updated_by", Value = @Model.updated_date })
                            @Html.HiddenFor(model => model.payment_type, new { id = "payment_type", @Name = "payment_type", Value = "4" })


                            @Html.HiddenFor(model => model.giftcard_id)
                            @Html.HiddenFor(model => model.id)
                            @Html.HiddenFor(model => model.establishment)
                            @Html.HiddenFor(model => model.theAddress)
                            @Html.HiddenFor(model => model.resource_uri)
                            @Html.HiddenFor(model => model.customer)
                            @Html.HiddenFor(model => model.address)

                            @Html.HiddenFor(model => model.theCustomer)
                            @Html.HiddenFor(model => model.RewardsCardNew)
                            @Html.HiddenFor(model => model.LinkingRevelCustomerID)
                            @Html.HiddenFor(model => model.LinkingRevelRewardsCardNewID)



                            <div class="form-group">
                                <label>Card Value £</label>
                                <br />
                                <div class="col-md-6">
                                    <input class="form-control" type="text" name="initial_value" readonly value="@Model.initial_value" />
                                    @Html.ValidationMessageFor(model => model.initial_value)
                                </div>
                            </div>

                            <div class="form-group">
                                <label>Card Number</label>
                                <br />
                                <div class="col-md-6">
                                    <input class="form-control" type="text" name="number" readonly value="@Model.number" />
                                    @Html.ValidationMessageFor(model => model.number)
                                </div>
                            </div>

                            @* <div class="form-group">
                                    <label></label>
                                    <div class="col-md-10">
                                        @Html.EditorFor(model => model.payment_type)
                                        @Html.ValidationMessageFor(model => model.payment_type)
                                    </div>
                                </div>*@

                            <div class="form-group">
                                <label>Remaining Balance</label>
                                <br />
                                <div class="col-md-6">
                                    @Html.EditorFor(model => model.remaining_balance)
                                    @Html.ValidationMessageFor(model => model.remaining_balance)
                                </div>
                            </div>



                            <div class="form-group">

                                <input type="submit" value="Update" class="btn btn-default" />

                            </div>
                        </div>
                    }

                    <div>
                        <a href="~/GiftCard/Index">Back to List</a>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>


