@model IEnumerable<Revel._808nd.com.Classes.GiftCard>

@{
    ViewBag.Title = "Gift Card Index";
}

@Html.Partial("~/PartialViews/BreadcrumbBarPartial.cshtml")



<div class="wrapper wrapper-content animated fadeInRight">
    <div class="row">

        <div class="col-lg-12">
            <div class="ibox float-e-margins">
                <div class="ibox-title">
                    <h5>@ViewBag.Title</h5>
                    <div class="ibox-tools">
                        <a class="collapse-link">
                            <i class="fa fa-chevron-up"></i>
                        </a>
                        <a class="dropdown-toggle" data-toggle="dropdown" href="#">
                            <i class="fa fa-wrench"></i>
                        </a>
                        <ul class="dropdown-menu dropdown-user">
                            <li>
                                <a href="#">Config option 1</a>
                            </li>
                            <li>
                                <a href="#">Config option 2</a>
                            </li>
                        </ul>
                        <a class="close-link">
                            <i class="fa fa-times"></i>
                        </a>
                    </div>
                </div>
                <div class="ibox-content">

                    <table id="myDataTable2" class="table">
                        <thead>
                            <tr>
                                <th>
                                    Number
                                </th>
                                <th>
                                    Created By
                                </th>
                                <th>
                                    Created Date
                                </th>
                                <th>
                                    Customer
                                </th>
                                @*    <th>
                                        Establishment
                                    </th>*@
                                <th>
                                    Id
                                </th>
                                <th>
                                    Initial Value
                                </th>

                                <th>
                                    Remaining Balance
                                </th>
                                <th>
                                    Resource URI
                                </th>
                                <th>
                                    Updated By
                                </th>
                                <th>
                                    Updated Date
                                </th>
                                <th>
                                    Revel Customer
                                </th>
                                <th>
                                    Revel Card
                                </th>
                                <th>
                                    Links
                                </th>
                            </tr>
                        </thead>

                        <tbody></tbody>

                    </table>

                </div>
            </div>
        </div>
    </div>
</div>



<script>
    $(document).ready(function () {

        $('#myDataTable2').dataTable({
            "pageLength": 50,
            "bServerSide": true,
            "scrollX": true,
            "sAjaxSource": "AjaxHandler",
            "bProcessing": true,
            "aoColumns": [
                  { "sName": "number" },
                { "sName": "created_by" },
                 { "sName": "created_date" },
                            { "sName": "customer" },
                          /*  { "sName": "establishment" },*/
                            { "sName": "id" },
                            { "sName": "initial_value" },
                           { "sName": "remaining_balance" },
                                { "sName": "resource_uri" },
                                 { "sName": "updated_by" },
                                   { "sName": "updated_date" },
            { "sName": "LinkingRevelCustomerID" },
                                   { "sName": "LinkingRevelRewardsCardNewID" },
            { "sName": "edit" }

            ],

            responsive: true,
            dom: '<"html5buttons"B>lTfgitp',
            buttons: [
                   { extend: 'copy' },
                   { extend: 'csv' },
                   { extend: 'excel', title: '@ViewBag.Title' },
                   { extend: 'pdf', title: '@ViewBag.Title' },

                   {
                       extend: 'print',
                       customize: function (win) {
                           $(win.document.body).addClass('white-bg');
                           $(win.document.body).css('font-size', '10px');

                           $(win.document.body).find('table')
                                   .addClass('compact')
                                   .css('font-size', 'inherit');
                       }
                   }
            ]
        });
    });
</script>
