@using System.Web.UI.WebControls
@using Revel._808nd.com.Classes
@model Revel._808nd.com.Classes.MenuPermissions

@{
    ViewBag.Title = "Create Menu Permissions";

    var establishments = (List<SelectListItem>)ViewBag.Ests;
    var menuTypes = (IEnumerable<SelectListItem>)ViewBag.MenuTypes;

}



@Html.Partial("~/PartialViews/BreadcrumbBarPartial.cshtml")

<div class="wrapper wrapper-content animated fadeInRight">
    <div class="row">

        <div class="col-lg-12">
            <div class="ibox float-e-margins">
                <div class="ibox-title">
                    <h5>@ViewBag.Title</h5>
                    <div class="ibox-tools">
                        <a class="collapse-link">
                            <i class="fa fa-chevron-up"></i>
                        </a>
                        <a class="dropdown-toggle" data-toggle="dropdown" href="#">
                            <i class="fa fa-wrench"></i>
                        </a>
                        <ul class="dropdown-menu dropdown-user">
                            <li>
                                <a href="#">Config option 1</a>
                            </li>
                            <li>
                                <a href="#">Config option 2</a>
                            </li>
                        </ul>
                        <a class="close-link">
                            <i class="fa fa-times"></i>
                        </a>
                    </div>
                </div>
                <div class="ibox-content">

                    @using (Html.BeginForm())
                    {
                        @Html.AntiForgeryToken()

                        <div class="form-horizontal">
                            <h4>Menu Permissions</h4>
                            <hr />
                            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                            <div class="row">
                                <div class="col-lg-4">
                                    @Html.Label("Establishment Name")
                                    @Html.DropDownListFor(x => x.Establishment.DBKEY_establishment_id, new SelectList(establishments, "Value", "Text"), new { @class = "form-control" })
                                </div>

                            </div>
                            <br />
                            <div class="row">
                                <div class="col-lg-4">
                                    @Html.Label("Menu Type")
                                    @Html.DropDownListFor(x => x.MenuType.id, new SelectList(menuTypes, "Value", "Text"), new { @class = "form-control" })
                                </div>
                            </div>
                            <br />
                            <br />
                            <div>
                                <input type="submit" value="Create" class="btn btn-default" />
                            </div>

                        </div>
                    }

                    <div>
                        @Html.ActionLink("Back to List", "Index")
                    </div>

                </div>

            </div>

        </div>
    </div>
</div>

