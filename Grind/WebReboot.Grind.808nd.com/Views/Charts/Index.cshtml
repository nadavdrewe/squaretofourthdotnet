@using System.Drawing
@using extension.railgunit.com.Color
@using Revel._808nd.com.ReportingModel.ChartModels

@{
    Layout = "~/Views/Shared/_BILayout.cshtml";

    var ests = ViewBag.EstablishmentsSelect as List<SelectListItem>;
    var hasFired = ViewBag.HasFired;
    var establishment = ViewBag.Establishment;

    //charts
    var stackedColumnData = ViewBag.ItemStackedColumnData as StackedChartItemGrouping;
    var noOrdersData = ViewBag.NumberOfOrdersData as List<ChartData>;

    var weeklySalesData = ViewBag.WeeklySalesData as List<ChartData>;

    //tables
    var table_totalPureSalesEachWeek = ViewBag.Table_TotalPureSales as List<ChartWeekItemSales>;
    var table_sumOfTotalQuantity = ViewBag.Table_SumOfTotalQuantity as List<ChartWeekItemSales>;
    var table_AverageItemValue = ViewBag.Table_AverageItemValue as List<ChartWeekItemSales>;
    var table_AverageNoOfItemsPerOrder = ViewBag.Table_AverageNoOfItemsPerOrder as List<ChartWeekItemSales>;
    var table_AverageOrderValue = ViewBag.Table_AverageOrderValue as List<ChartWeekItemSales>;

    List<string> randomColoursList = new List<string>();

    Random random;
    for (int i = 0; i < 50; i++)
    {
        random = new Random(i);
        var color = String.Format("#{0:X6}", random.Next(0x1000000));
        randomColoursList.Add(color);
    }

    Random randomGen = new Random();
    KnownColor[] names = (KnownColor[])Enum.GetValues(typeof(KnownColor));


    List<string> colorNames = names.Select(x => x.ToString()).ToList();
    int numColors = colorNames.Count();

}

