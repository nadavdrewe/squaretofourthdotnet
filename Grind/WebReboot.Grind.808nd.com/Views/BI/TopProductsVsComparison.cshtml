@model Revel._808nd.com.ReportingModel.OrderItemProductGroupingComparisonList

    @{
        var allProds = new List<int>();

        /*   Model.Items = Model.Items
               .Where(x => x.ProductIdentifier.ToLower().Contains("smoothie"))
                .Where(x => x.ProductIdentifier.ToLower().Contains("juice"))
              /*   .Where(x => x.ProductIdentifier.ToLower() == "red smoothie")
                  .Where(x => x.ProductIdentifier.ToLower() == "espresso martini")#1#
                   .Where(x => x.ProductIdentifier.ToLower() != "£5")
                    .Where(x => x.ProductId != 3274)
                    .Where(x => x.ProductId != 3275)
                    .Where(x => x.ProductId != 3276)
                    .Where(x => x.ProductId != 3337)
                       .Where(x => x.ProductId != 3338)
                          .Where(x => x.ProductId != 3339).ToList();
       */
        foreach (var product in Model.Items.OrderByDescending(x => x.TotalPureSales).ToList())
        {
            allProds.Add(product.ProductId);
        }


    }
    @*<h3>Top Sellers</h3>*@
    <table class="table table-primary" id="thisTable">
        <thead>
            <tr>
                <th>
                    Product
                </th>
                <th>
                    Number Sold
                </th>
                @*<th>
                    Vs Last Week
                </th>*@
                <th>
                    Sales
                </th>
                @*<th>
                    Vs Last Week
                </th>
*@                @*<th>
                    Average Value
                </th>
                <th>
                    Vs Last Week
                </th>*@
            </tr>
        </thead>

        <tbody>
            @{

                var loop = 0;
                foreach (var prodID in allProds)
                {


                    <tr>
                        <td>@Model.Items.First(x => x.ProductId == prodID).ProductIdentifier</td>
                        <td id="data-quantity-@loop" class="data-quantity @loop">@Decimal.Round(Model.Items.Where(x => x.ProductId == prodID).Sum(x => x.TotalQuantity))</td>
                       @* <td id="data-compQuantity-@loop" class="data-compQuantity @loop">@Decimal.Round(Model.ComparisonItems.Where(x => x.ProductId == prodID).Sum(x => x.TotalQuantity))</td>*@
                        <td>£@Decimal.Round(Model.Items.Where(x => x.ProductId == prodID).Sum(x => x.TotalPureSales))</td>
                      @*  <td>£@Decimal.Round(Model.ComparisonItems.Where(x => x.ProductId == prodID).Sum(x => x.TotalPureSales))</td>
                        <td>
                            @{
                                var currentSales = Model.Items.Where(x => x.ProductId == prodID).Sum(x => x.TotalPureSales);
                                var currentItems = Model.Items.Where(x => x.ProductId == prodID).Sum(x => x.TotalQuantity);
                                if (currentSales > 0 && currentItems > 0)
                                {
                                    @("£")@(Decimal.Round(currentSales / currentItems, 2))


                                }
                                else
                                {
                                    @("£")@Html.Raw("0")
                                }

                            }


                        </td>



                        <td>
                            @{
                                var compareSales = Model.ComparisonItems.Where(x => x.ProductId == prodID).Sum(x => x.TotalPureSales);
                                var compareItems = Model.ComparisonItems.Where(x => x.ProductId == prodID).Sum(x => x.TotalQuantity);

                                if (compareItems > 0 && compareSales > 0)
                                {
                                    @("£")@(Decimal.Round(compareSales / compareItems, 2))
                                }
                                else
                                {
                                    @("£")@Html.Raw("0")
                                }
                            }

                        </td>*@
                    </tr>
                                    loop++;
                                }
            }

        </tbody>
    </table>



