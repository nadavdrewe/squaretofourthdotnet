@model IEnumerable<Revel._808nd.com.ReportingModel.TopSeller>

@{
    ViewBag.Title = "Hour and spend breakdown";


    var establishmentListItems = (IEnumerable<SelectListItem>)ViewBag.EstablishmentsSelect;
    var users = (IEnumerable<SelectListItem>)ViewBag.UsersSelect;

    var topSellers = (IEnumerable<Revel._808nd.com.ReportingModel.TopSeller>)ViewBag.TopSellers;
    var productWatch = (IEnumerable<Revel._808nd.com.ReportingModel.TopSeller>)ViewBag.ProductWatch;
    var avgBasket = (IEnumerable<Revel._808nd.com.ReportingModel.TopSeller>)ViewBag.AvgBasket;
    var hourAndSpend = (IEnumerable<Revel._808nd.com.ReportingModel.HourAndSpend>)ViewBag.HourAndSpends;

    var startAndEnd = (IEnumerable<DateTime>)ViewBag.DateRange;

    var hasFired = (bool)ViewBag.HasFired;

}

@if (hasFired)
{
    var HowLong = ViewBag.HowLong.ToString();
    var orders = ViewBag.Orders;
    var items = ViewBag.Items;
    var days = ViewBag.Days;

    <h2>Current Reporting Dates: @startAndEnd.First().ToString("dd/MM/yyyy") - @startAndEnd.ElementAt(1).ToString("dd/MM/yyyy") - Query took @HowLong seconds, over @days days, @orders orders and @items individual items</h2>
}




@Html.Partial("~/PartialViews/BreadcrumbBarPartial.cshtml")

<div class="wrapper wrapper-content animated fadeInRight">
    <div class="row">

        <div class="col-lg-12">
            <div class="ibox float-e-margins">
                <div class="ibox-title">
                    <h5>Select dates to profile</h5>
                    <div class="ibox-tools">
                        <a class="collapse-link">
                            <i class="fa fa-chevron-up"></i>
                        </a>
                        <a class="dropdown-toggle" data-toggle="dropdown" href="#">
                            <i class="fa fa-wrench"></i>
                        </a>
                        <ul class="dropdown-menu dropdown-user">
                            <li>
                                <a href="#">Config option 1</a>
                            </li>
                            <li>
                                <a href="#">Config option 2</a>
                            </li>
                        </ul>
                        <a class="close-link">
                            <i class="fa fa-times"></i>
                        </a>
                    </div>
                </div>
                <div class="ibox-content">

                    @using (Html.BeginForm("Index", "BI", FormMethod.Post))
                    {

                        <div class="form-block">

                            <div>
                                <input class="form-control datepicker" type="text" name="start" placeholder="Start Date" required/>
                            </div>
                            <div>
                                <input class="form-control datepicker" type="text" name="end" placeholder="End Date" required/>
                            </div>
                            <div>
                                @Html.ListBox("EstablishmentId", establishmentListItems, new {@class = "form-control datepicker", style = "height:130px;", required = true})
                            </div>
                            <div>
                                @Html.DropDownList("UserURI", users, new {@class = "form-control datepicker"})
                            </div>
                            <input type="submit" value="Go" class="btn btn-primary"/>
                        </div>


                    }

                    @if (hasFired)
                    {
                        <div class="row-fluid">
                            @Html.Partial("TopSellersPartial", topSellers.OrderByDescending(x => x.ValuePounds))
                        </div>
                        <div class="row-fluid">
                            @Html.Partial("TopProductsPartial", productWatch.OrderByDescending(x => x.ValuePounds))
                        </div>
                        <div class="row-fluid">
                            @Html.Partial("AvgBasketSizePartial", avgBasket.OrderByDescending(x => x.ValuePounds))
                        </div>

                        <div class="row-fluid">
                            @Html.Partial("HourAndSpendsPartial", hourAndSpend.OrderBy(x => x.Date))
                        </div>

                    }

                </div>

            </div>

        </div>
    </div>
</div>


<script type="text/javascript">


    $(document).ready(function () {
        $('.myDatatable').DataTable(
        {
            "pageLength": 50
        }
        );


        $('#message').fadeIn(2000);
        $('#message').delay(2000);
        $('#message').fadeOut(2000);

    });



</script>
