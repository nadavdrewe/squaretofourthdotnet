@model data.pipeline.fourth.com.Models.BrandIntegration
@using data.pipeline.fourth.com.Models;

@{
    ViewData["Title"] = "Edit";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var stores = ViewData["stores"] as List<Store>;
    var integrationOfThisType = ViewData["integrations"] as List<StoreIntegration>;

    var next = "";
}

<h1>Edit</h1>

<h4>Brand Integration - @Model.Brand.Name - @Model.IntegrationType</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="BrandId" class="control-label">Brand</label>
                <select asp-for="BrandId" class="form-control" asp-items="ViewBag.BrandId"></select>
            </div>
            <div class="form-group">
                <label asp-for="IntegrationType" class="control-label"></label>
                <select asp-for="IntegrationType" asp-items="Html.GetEnumSelectList<shared.pipeline.fourth.com.IntegrationTypes>()" class="form-control"></select>
                <span asp-validation-for="IntegrationType" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="IntegrationSubType" class="control-label"></label>
                <select asp-for="IntegrationSubType" disabled asp-items="Html.GetEnumSelectList<shared.pipeline.fourth.com.IntegrationSubTypes>()" class="form-control"></select>
                <span asp-validation-for="IntegrationSubType" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="StartBatchQueryTimeUTC" class="control-label">Start Batch Query Time UTC</label>
                <input asp-for="StartBatchQueryTimeUTC" class="form-control" />
                <span asp-validation-for="StartBatchQueryTimeUTC" class="text-danger"></span>
            </div>          
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="Active" /> @Html.DisplayNameFor(model => model.Active)
                </label>
            </div>
            <div class="form-group">
                <input type="submit" value="Update" class="btn btn-primary" />
                <input value="Verify This Integration" onclick="verifyIntegration()" class="btn btn-inverse-success" />
            </div>
            <div class="form-group">
                <input value="Generate Test Data" onclick="generateTestData()" class="btn btn-danger" />
                <input value="Check Missing Stores" onclick="checkMissingStoresForThisIntegration()" class="btn btn-secondary" />
            </div>
        </form>
    </div>
</div>

<div class="table-responsive">
    <h4>Store Integrations For This Integration</h4>
    <table id="order-listing" class="table table-dark">
        <thead>
            <tr>
                <th>Store Name</th>
                <th>Integration Type</th>
                <th>Active</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in integrationOfThisType)
            {

            <tr>
                <td>@item.Store.Name</td>
                <td>@item.IntegrationType</td>
                <td>@item.Active </td>
            </tr>
            }
        </tbody>
    </table>
</div>
<br />

<div>
    <a asp-action="Index">Back to List</a>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/FileSaver.js/1.3.8/FileSaver.min.js"></script>
<script type="text/javascript">

    function saveDynamicDataToFile(data, filename) {
            var userInput = data;
            var blob = new Blob([userInput], { type: "text/plain;charset=utf-8" });
            saveAs(blob, filename);
        }

    $(document).ready(function () {
        console.log("ready!");
    });

    checkMissingStoresForThisIntegration = () => {
          $.ajax({
            data: {
                "brandIntegrationId": "@Model.Id",
                "integrationType": "@Model.IntegrationType"
            },
            method: "GET",
            url: "/BrandIntegrations/CheckMissingStoresForIntegration"
        }).done(function () {
            alert("All stores up to date!!")
        }).fail((error) => {
            let errorsArray = error.responseJSON;
            let stringError = "\n";
            errorsArray.map(x => {
                 stringError += x + "\n";
            });
            alert("Awww it didn't work: " + stringError);
        });
    }

    verifyIntegration = () => {
        $.ajax({
            data: {
                "brandIntegrationId": "@Model.Id",
                "integrationType": "@Model.IntegrationType"
            },
            method: "GET",
            url: "/BrandIntegrations/_VerifyBrandIntegrationStack_SquareToFourth"
        }).done(function () {
            alert("Integration verified!!")
        }).fail((error) => {
            let errorsArray = error.responseJSON;
            let stringError = "\n";
            errorsArray.map(x => {
                 stringError += x + "\n";
            });
            alert("Awww it didn't work: " + stringError);
        });
    }

    generateTestData = () => {
        $.ajax({
            data: {
                "brandIntegrationId": "@Model.Id",
                "integrationType": "@Model.IntegrationType"
            },
            method: "GET",
            url: "/BrandIntegrations/GenerateTestData"
        }).done(function (data) {
            data.map(eachCsv => {
                alert("CSV generated (check console): " + eachCsv.csvName);
                console.log(eachCsv.csvString);
                saveDynamicDataToFile(eachCsv.csvString, eachCsv.csvName);
            })

        }).fail((error) => {
            let errorsArray = error.responseJSON;
            let stringError = "\n";
            errorsArray.map(x => {
                 stringError += x + "\n";
            });
            alert("Awww it didn't work: " + stringError);
        });
    }


</script>