@model IEnumerable<data.pipeline.fourth.com.Models.BrandIntegration>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Brand Integrations Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table id="order-listing" class="table table-dark">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Brand.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IntegrationType)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IntegrationSubType)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.StartBatchQueryTimeUTC)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Active)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Brand.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.IntegrationType)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.IntegrationSubType)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.StartBatchQueryTimeUTC)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Active)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
