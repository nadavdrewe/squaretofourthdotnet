@{
    Layout = null;
    var hasSquareApplications = ViewData["hasSquareApplications"] is bool hasApplications && hasApplications;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Connect your Square account</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@500&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <style>
        :root { --ink: #000; --muted: #666; --line: #dedede; --paper: #fff; }
        * { box-sizing: border-box; }
        body { min-height: 100vh; margin: 0; display: grid; place-items: center; padding: 24px; color: var(--ink); font-family: "DM Sans", sans-serif; background: #f7f7f7; }
        .shell { width: min(100%, 520px); }
        .identity { display: flex; align-items: center; margin-bottom: 18px; }
        .identity img { display: block; width: 126px; height: auto; }
        .card { padding: 34px; border: 1px solid var(--line); border-radius: 18px; background: var(--paper); box-shadow: 0 18px 48px rgba(0,0,0,.08); }
        .eyebrow { margin: 0 0 12px; color: #555; font: 500 12px "DM Mono", monospace; letter-spacing: .1em; text-transform: uppercase; }
        h1 { margin: 0; font-size: clamp(2rem, 7vw, 3rem); line-height: 1; letter-spacing: -.055em; }
        .lede { margin: 14px 0 26px; color: var(--muted); line-height: 1.55; }
        label { display: block; margin-bottom: 7px; font-size: .86rem; font-weight: 700; }
        .field { margin-bottom: 18px; }
        select { width: 100%; min-height: 50px; padding: 0 13px; border: 1px solid var(--line); border-radius: 12px; background: #fff; color: var(--ink); font: inherit; }
        select:focus { outline: 3px solid rgba(0,0,0,.12); border-color: #000; }
        .button { width: 100%; min-height: 52px; border: 0; border-radius: 13px; background: #111; color: #fff; font: 700 1rem "DM Sans", sans-serif; cursor: pointer; }
        .button:hover { background: #292929; }
        .alert { margin-bottom: 20px; padding: 13px 15px; border: 1px solid #e5b9b1; border-radius: 12px; background: #fff3f1; color: #8a3326; font-size: .9rem; }
        .empty { padding: 18px; border: 1px dashed var(--line); border-radius: 14px; background: #f7f7f7; }
        .empty strong { display: block; margin-bottom: 5px; }
        .empty p { margin: 0 0 14px; color: var(--muted); font-size: .9rem; line-height: 1.45; }
        .link { color: #000; font-weight: 700; text-decoration: underline; }
        .meta { display: flex; justify-content: space-between; gap: 12px; margin-top: 18px; color: var(--muted); font-size: .82rem; }
        .meta a { color: #000; text-decoration: underline; font-weight: 700; }
        @@media (max-width: 540px) { body { padding: 14px; } .card { padding: 25px 21px; } .meta { flex-direction: column; } }
    </style>
</head>
<body>
    <main class="shell">
        <div class="identity"><img src="https://images.ctfassets.net/1nw4q0oohfju/7ntgEwkWoRRGdTu91jr9yd/62d9d5b8a06107447c15cbbfffd2abb7/brand_black-f67a0600187e707deb22521e86452dd6746851870f815e9e454423b9e5b8a6d3.png" alt="Built with Square" /></div>
        <section class="card">
            <p class="eyebrow">Protected connection setup</p>
            <h1>Connect a Square account</h1>
            <p class="lede">Select the client and the Square developer application that should own this OAuth connection.</p>

            @if (TempData["Error"] != null)
            {
                <div class="alert">@TempData["Error"]</div>
            }

            @if (!hasSquareApplications)
            {
                <div class="empty">
                    <strong>No Square OAuth applications are available.</strong>
                    <p>Add the application ID, secret, environment, and redirect URL from Square before connecting a client.</p>
                    @if (User.IsInRole("Administrator"))
                    {
                        <a class="link" asp-controller="SquareOAuthApplications" asp-action="Create">Add a Square application</a>
                    }
                </div>
            }
            else
            {
                <form asp-action="Authorize" method="post">
                    <div class="field">
                        <label for="brandId">Client</label>
                        <select id="brandId" name="brandId" asp-items="ViewBag.brandList"></select>
                    </div>
                    <div class="field">
                        <label for="squareOAuthApplicationId">Square application</label>
                        <select id="squareOAuthApplicationId" name="squareOAuthApplicationId" asp-items="ViewBag.squareApplicationList"></select>
                    </div>
                    <button type="submit" class="button">Continue to Square</button>
                </form>
            }

            <div class="meta">
                <span>Square handles the account login and consent.</span>
                @if (User.IsInRole("Administrator"))
                {
                    <a asp-controller="SquareOAuthApplications" asp-action="Index">Manage applications</a>
                }
            </div>
        </section>
    </main>
</body>
</html>
