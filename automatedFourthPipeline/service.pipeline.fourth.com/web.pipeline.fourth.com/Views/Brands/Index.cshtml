@model IEnumerable<data.pipeline.fourth.com.Models.Brand>
@{
    ViewData["Title"] = "Clients";
}

<div class="page-header">
    <div><h1>Clients</h1><p class="text-muted mb-0">Client records own the Square OAuth connection, stores, and Fourth delivery configuration.</p></div>
    <a class="btn btn-primary" asp-action="Create"><i class="mdi mdi-plus mr-1"></i>Add client</a>
</div>
<section class="card sf-panel">
    @if (!Model.Any())
    {
        <div class="sf-empty"><i class="mdi mdi-domain-plus" aria-hidden="true"></i><h2>No clients configured</h2><p>Add the first client before starting the Square OAuth connection.</p><a class="btn btn-primary" asp-action="Create">Add client</a></div>
    }
    else
    {
        <div class="sf-table-wrap"><table class="table table-hover"><thead><tr><th>Client</th><th>Contact</th><th>Currency</th><th>Region</th><th>Status</th><th></th></tr></thead><tbody>
        @foreach (var item in Model)
        {
            <tr><td><strong>@item.Name</strong></td><td>@(item.ContactName ?? "No contact")<br /><small class="text-muted">@(item.ContactEmail ?? "No email")</small></td><td>@item.Currency</td><td>@item.Region</td><td><span class="sf-status @(item.Active ? "sf-status-live" : "sf-status-muted")">@(item.Active ? "Active" : "Inactive")</span></td><td><div class="sf-actions"><a class="btn btn-outline-primary btn-sm" asp-action="Edit" asp-route-id="@item.Id">Edit</a><a class="btn btn-outline-secondary btn-sm" asp-action="Details" asp-route-id="@item.Id">Details</a><a class="btn btn-outline-danger btn-sm" asp-action="Delete" asp-route-id="@item.Id">Delete</a></div></td></tr>
        }
        </tbody></table></div>
    }
</section>
