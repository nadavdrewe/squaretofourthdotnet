@model IEnumerable<data.pipeline.fourth.com.Models.Brand>

@{
    ViewData["Title"] = "CreateNewSquareToFourthSalesIntegration";
    var brandList = ViewData["BrandList"] as SelectList;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Set up new Square -> Fourth Sales Integration</h1>

<div class="row">
    <div class="col-md-4">
        <form asp-action="CreateNewSquareToFourthSalesIntegration" method="post">
            <div class="form-group">
                <label class="control-label">Which Brand?</label>
                <select name="whichBrand" id="whichBrand" class="form-control" asp-items="brandList"></select>
            </div>
            <div class="form-group">
                <label class="control-label">Fourth Unit ID</label>
                <input id="unitID" name="unitID" class="form-control" />
            </div>
            @*<div class="form-group">
                <label class="control-label">Create Square To Fourth Sales Integrations?</label>
                <select id="createIntegration" class="form-control" name="createIntegration">
                    <option value="false">No</option>
                    <option value="true">Yes</option>
                </select>
                <span class="text-danger"></span>
            </div>*@
            <div class="form-group">
                <label class="control-label">Revenue Center Type</label>
                <select id="revenueCenters" name="revenueCenters" asp-items="Html.GetEnumSelectList<com.fourth.pipeline.pos.Enum.FourthSalesRevenueCenterMappingType>()" class="form-control"></select>
                <span class="text-danger"></span>
            </div>
            <div class="form-group">
                <input value="Save" class="btn btn-primary" onclick="createNewIntegration()" />
            </div>
        </form>
    </div>
</div>


<script>
    createNewIntegration = () => {
        $.ajax({
            data: {
                "whichBrand": $('#whichBrand').val(),
                "unitID": $('#unitID').val(),                
                "revenueCenters": $('#revenueCenters').val()
            },
            method: "POST",
            url: "/Brands/CreateNewSquareToFourthSalesIntegration"
        }).done(function (response) {
            alert("Done!!! New integration created");
        }).fail(() => {
            alert("Awww it didn't work!! Please check the creds");
        });
    }
</script>