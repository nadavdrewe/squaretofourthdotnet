@model data.pipeline.fourth.com.Models.Configs.Store.FourthSalesApiStoreConfig

@{
    ViewData["Title"] = "Create";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Create</h1>

<h4>Fourth Sales Api Store Config</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="UnitId" class="control-label"></label>
                <input asp-for="UnitId" class="form-control" />
                <span asp-validation-for="UnitId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="SiteLocationCode" class="control-label"></label>
                <input asp-for="SiteLocationCode" class="form-control" />
                <span asp-validation-for="SiteLocationCode" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="RevenueCenter" class="control-label"></label>
                <input asp-for="RevenueCenter" class="form-control" />
                <span asp-validation-for="RevenueCenter" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="RevenueCenterMappingType" class="control-label"></label>
                <select asp-for="RevenueCenterMappingType" class="form-control"></select>
                <span asp-validation-for="RevenueCenterMappingType" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="StoreIntegrationId" class="control-label"></label>
                <select asp-for="StoreIntegrationId" class ="form-control" asp-items="ViewBag.StoreIntegrationId"></select>
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="Active" /> @Html.DisplayNameFor(model => model.Active)
                </label>
            </div>
            <div class="form-group">
                <label asp-for="WhenCreatedUTC" class="control-label"></label>
                <input asp-for="WhenCreatedUTC" class="form-control" />
                <span asp-validation-for="WhenCreatedUTC" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="WhenUpdatedUTC" class="control-label"></label>
                <input asp-for="WhenUpdatedUTC" class="form-control" />
                <span asp-validation-for="WhenUpdatedUTC" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
