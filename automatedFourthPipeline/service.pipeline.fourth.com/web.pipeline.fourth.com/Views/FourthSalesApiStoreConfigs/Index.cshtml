@model IEnumerable<data.pipeline.fourth.com.Models.Configs.Store.FourthSalesApiStoreConfig>
@{
    ViewData["Title"] = "Fourth Sales Mappings";
}

<div class="page-header">
    <div><h1>Fourth sales mappings</h1><p class="text-muted mb-0">Set the Fourth unit, location and revenue centre values used in the existing Fourth sales upload contract.</p></div>
    <a class="btn btn-primary" asp-action="Create"><i class="mdi mdi-plus mr-1"></i>Add mapping</a>
</div>
<section class="card sf-panel">
    @if (!Model.Any())
    {
        <div class="sf-empty"><i class="mdi mdi-file-delimited" aria-hidden="true"></i><h2>No Fourth sales mappings</h2><p>Add the Fourth destination values for each mapped store before enabling its sales export.</p><a class="btn btn-primary" asp-action="Create">Add mapping</a></div>
    }
    else
    {
        <div class="sf-table-wrap"><table class="table table-hover"><thead><tr><th>Fourth unit</th><th>Site location</th><th>Revenue centre</th><th>Mapping type</th><th>Store integration</th><th>Status</th><th>Updated UTC</th><th></th></tr></thead><tbody>
        @foreach (var item in Model)
        {
            <tr><td><code>@item.UnitId</code></td><td><code>@item.SiteLocationCode</code></td><td>@item.RevenueCenter</td><td>@item.RevenueCenterMappingType</td><td>@item.StoreIntegration?.Store?.Name</td><td><span class="sf-status @(item.Active ? "sf-status-live" : "sf-status-muted")">@(item.Active ? "Active" : "Inactive")</span></td><td>@item.WhenUpdatedUTC.ToString("yyyy-MM-dd HH:mm")</td><td><div class="sf-actions"><a class="btn btn-outline-primary btn-sm" asp-action="Edit" asp-route-id="@item.Id">Edit</a><a class="btn btn-outline-secondary btn-sm" asp-action="Details" asp-route-id="@item.Id">Details</a><a class="btn btn-outline-danger btn-sm" asp-action="Delete" asp-route-id="@item.Id">Delete</a></div></td></tr>
        }
        </tbody></table></div>
    }
</section>
