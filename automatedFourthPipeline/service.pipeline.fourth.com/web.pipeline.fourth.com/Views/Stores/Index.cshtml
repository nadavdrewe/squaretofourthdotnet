@model IEnumerable<data.pipeline.fourth.com.Models.Store>
@{
    ViewData["Title"] = "Stores";
}

<div class="page-header">
    <div><h1>Stores</h1><p class="text-muted mb-0">Stores provide the local timezone and the operational link between Square locations and Fourth.</p></div>
    <a class="btn btn-primary" asp-action="Create"><i class="mdi mdi-plus mr-1"></i>Add store</a>
</div>
<section class="card sf-panel">
    @if (!Model.Any())
    {
        <div class="sf-empty"><i class="mdi mdi-store-plus" aria-hidden="true"></i><h2>No stores configured</h2><p>Add a store to begin mapping a Square location to a Fourth integration.</p><a class="btn btn-primary" asp-action="Create">Add store</a></div>
    }
    else
    {
        <div class="sf-table-wrap"><table class="table table-hover"><thead><tr><th>Store</th><th>Client</th><th>Timezone</th><th>Status</th><th></th></tr></thead><tbody>
        @foreach (var item in Model)
        {
            <tr><td><strong>@item.Name</strong></td><td>@item.Brand?.Name</td><td><code>@item.Timezone</code></td><td><span class="sf-status @(item.Active ? "sf-status-live" : "sf-status-muted")">@(item.Active ? "Active" : "Inactive")</span></td><td><div class="sf-actions"><a class="btn btn-outline-primary btn-sm" asp-action="Edit" asp-route-id="@item.Id">Edit</a><a class="btn btn-outline-secondary btn-sm" asp-action="Details" asp-route-id="@item.Id">Details</a><a class="btn btn-outline-danger btn-sm" asp-action="Delete" asp-route-id="@item.Id">Delete</a></div></td></tr>
        }
        </tbody></table></div>
    }
</section>
