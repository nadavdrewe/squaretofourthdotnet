@{
    Layout = "_SapLayout";
    ViewData["Title"] = "Turn every sale into operational clarity";
    ViewData["BodyClass"] = "sap-landing-v2";
}

<section class="sap-v2-hero">
    <div class="sap-v2-copy">
        <p class="eyebrow">Square sales <span aria-hidden="true">&times;</span> SAP operations</p>
        <h1>Turn every sale into <em>operational clarity.</em></h1>
        <p class="lead">Define how Square sales become trusted SAP inventory and finance data — with mappings, owners and decisions in one shared workspace.</p>
        <div class="actions">
            <a class="btn primary" href="/sap/requirements">Define your integration <span aria-hidden="true">&rarr;</span></a>
            <a class="btn secondary" href="#decision-model">Explore the model</a>
        </div>
        <ul class="sap-v2-trust" aria-label="Workspace features">
            <li><span class="trust-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M7 3h10v18H7zM10 7h4M10 11h4M10 15h3" /></svg></span>Saved drafts</li>
            <li><span class="trust-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 11V8a4 4 0 0 1 8 0v3M6 11h12v10H6z" /><circle cx="12" cy="16" r="1" /></svg></span>Private resume code</li>
            <li><span class="trust-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 15V3M8 7l4-4 4 4M5 13v8h14v-8" /></svg></span>PDF, CSV and JSON exports</li>
        </ul>
    </div>

    <aside class="sap-v2-blueprint" aria-label="Illustrative flow from Square sales through mapping, validation and reconciliation into SAP inventory and finance">
        <div class="blueprint-grid" aria-hidden="true"></div>
        <div class="blueprint-heading"><p class="blueprint-title">Your integration model</p><span class="blueprint-badge">Design workspace</span></div>
        <div class="blueprint-flow">
            <div class="system-card square-system">
                <img src="/images/brand/square-official.png" alt="Square" width="154" height="44" />
                <span>Sales · Payments · Returns</span>
            </div>
            <div class="mapping-lines" aria-label="Map, validate and reconcile">
                <span>Map</span><i></i>
                <span>Validate</span><i></i>
                <span>Reconcile</span><i></i>
            </div>
            <div class="system-card sap-system">
                <img src="/images/brand/sap.svg" alt="SAP" width="112" height="56" />
                <span>Business operations</span>
            </div>
        </div>
        <div class="blueprint-outputs">
            <div><span class="output-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 7l8-4 8 4-8 4zM4 7v10l8 4 8-4V7M12 11v10" /></svg></span><strong>Inventory</strong><small>Stock movements and ownership</small></div>
            <div><span class="output-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M6 3h12v18H6zM9 7h6M9 11h6M9 15h2M14 15h1" /></svg></span><strong>Finance</strong><small>Revenue, tax and settlement</small></div>
        </div>
        <p class="blueprint-note">Illustrative blueprint. Final interfaces depend on your SAP landscape and approved business process.</p>
    </aside>
</section>

<section id="decision-model" class="sap-v2-decisions">
    <div class="decision-heading">
        <div><span class="section-mark" aria-hidden="true"></span><h2>Six decisions. One shared plan.</h2></div>
        <p>Work through the key decisions to shape your integration, step by step.</p>
    </div>
    <ol class="decision-rail">
        <li><span class="decision-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><ellipse cx="12" cy="5" rx="7" ry="3" /><path d="M5 5v6c0 1.7 3.1 3 7 3s7-1.3 7-3V5M5 11v6c0 1.7 3.1 3 7 3s7-1.3 7-3v-6" /></svg></span><div><b>01</b><strong>SAP landscape</strong></div></li>
        <li><span class="decision-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 4h14v16H5zM8 8h8M8 12h8M8 16h5" /></svg></span><div><b>02</b><strong>Sales posting</strong></div></li>
        <li><span class="decision-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 7l8-4 8 4-8 4zM4 7v10l8 4 8-4V7M12 11v10" /></svg></span><div><b>03</b><strong>Inventory ownership</strong></div></li>
        <li><span class="decision-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M7 3h10v18H7zM10 7h4M10 11h4M10 15h3" /></svg></span><div><b>04</b><strong>Data detail</strong></div></li>
        <li><span class="decision-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 8h13M14 5l3 3-3 3M20 16H7M10 13l-3 3 3 3" /></svg></span><div><b>05</b><strong>Finance &amp; reconciliation</strong></div></li>
        <li><span class="decision-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 5h5v5H5zM14 5h5v5h-5zM5 14h5v5H5zM14 14h5v5h-5zM10 7h4M7 10v4M17 10v4M10 17h4" /></svg></span><div><b>06</b><strong>Mappings &amp; acceptance</strong></div></li>
    </ol>
</section>

<section id="resources" class="sap-v2-resources">
    <div><p class="eyebrow">A practical handover</p><h2>Requirements your team can work from.</h2><p>Add mappings, evidence, action owners and acceptance criteria. Use the built-in guide when a question needs unpacking, then export one agreed brief.</p></div>
    <ul><li>Context-aware guidance in every section</li><li>Saved drafts with private resume codes</li><li>Named decision owners and open actions</li><li>Requirements PDF, mapping CSV and structured JSON</li></ul>
</section>

<section class="sap-v2-closing"><div><p class="eyebrow">Start with what you know</p><h2>Make the integration discussable.</h2><p>Bring operations, SAP and finance into one shared decision model.</p></div><a class="btn primary" href="/sap/requirements">Start your requirements <span aria-hidden="true">&rarr;</span></a></section>
