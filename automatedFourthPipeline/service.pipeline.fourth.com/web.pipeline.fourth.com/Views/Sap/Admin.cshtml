@model System.Collections.Generic.List<SapDiscovery>
@{ Layout = "_SapLayout"; ViewData["Title"] = "Requirements administration"; }
<div class="page-intro"><p class="eyebrow">Integration administration</p><h1>SAP requirements.</h1><p>Latest 250 customer workspaces, ordered by last update. Open a project to review, export or approve its requirements.</p></div>
<div class="assistant-admin-status @(ViewData["SapAssistantConfigured"] as bool? == true ? "ready" : "pending")"><span class="assistant-mark" aria-hidden="true">AI</span><div><strong>Requirements guide: @(ViewData["SapAssistantConfigured"] as bool? == true ? "available" : "configuration required")</strong><p>@(ViewData["SapAssistantConfigured"] as bool? == true ? "Running " + ViewData["SapAssistantModel"] + " · prompt " + ViewData["SapAssistantPromptVersion"] + " · " + ViewData["SapAssistantDailyLimit"] + " requests per workspace/day. It cannot save or submit forms." : "Set SapAssistant__ApiKey and SapAssistant__Enabled=true in server configuration. Customers do not see an unavailable assistant.")</p></div></div>
<section class="panel"><div class="table-scroll"><table><thead><tr><th>Company</th><th>Contact</th><th>Status</th><th>Updated (UTC)</th><th></th></tr></thead><tbody>@foreach(var d in Model){<tr><td>@d.Company</td><td>@d.Contact<br />@d.Email</td><td>@d.Status · v@(d.Revision)</td><td>@d.UpdatedUtc.ToString("yyyy-MM-dd HH:mm")</td><td><a href="/sap/requirements/@d.Id/@SapDiscoverySchema.Phases.Length">Review workspace</a></td></tr>}@if(Model.Count==0){<tr><td colspan="5">No requirements workspaces yet.</td></tr>}</tbody></table></div></section>
