@model SapDiscovery
@{ Layout = "_SapLayout"; ViewData["Title"] = "Workspace created"; }
<section class="panel created"><p class="eyebrow">Ready for your team</p><h1>Your workspace<br />is open.</h1><p>Keep these details somewhere safe before continuing. The access code is shown once and is required to resume on another device.</p><dl><dt>Company</dt><dd>@Model.Company</dd><dt>Project reference</dt><dd><code>@Model.Id</code></dd><dt>Private access code</dt><dd><code>@ViewData["ResumeCode"]</code></dd></dl><p class="notice">Anyone with both values can read and edit this project's requirements. Collaborators enter their name when saving; customer names are self-declared, not verified identities.</p><a class="btn primary" href="/sap/requirements/@Model.Id/0">Begin SAP landscape ↗</a><button class="btn secondary" type="button" data-print>Print access details</button></section>
