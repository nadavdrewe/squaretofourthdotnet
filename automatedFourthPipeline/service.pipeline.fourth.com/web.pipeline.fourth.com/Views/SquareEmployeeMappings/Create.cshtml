@model data.pipeline.fourth.com.Models.Mappings.SquareEmployeeMapping

@{
    ViewData["Title"] = "Create Square Employee Mapping";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Create</h1>

<h4>Square Employee Mapping</h4>
<hr />
<div class="row">
    <div class="col-md-5">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="StoreIntegrationId" class="control-label"></label>
                <select asp-for="StoreIntegrationId" class="form-control" asp-items="ViewBag.StoreIntegrationId"></select>
                <span asp-validation-for="StoreIntegrationId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="SquareTeamMemberId" class="control-label"></label>
                <input asp-for="SquareTeamMemberId" class="form-control" />
                <span asp-validation-for="SquareTeamMemberId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="SquareDisplayName" class="control-label"></label>
                <input asp-for="SquareDisplayName" class="form-control" />
                <span asp-validation-for="SquareDisplayName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="FourthEmployeeNumber" class="control-label"></label>
                <input asp-for="FourthEmployeeNumber" class="form-control" />
                <span asp-validation-for="FourthEmployeeNumber" class="text-danger"></span>
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="Active" /> @Html.DisplayNameFor(model => model.Active)
                </label>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
