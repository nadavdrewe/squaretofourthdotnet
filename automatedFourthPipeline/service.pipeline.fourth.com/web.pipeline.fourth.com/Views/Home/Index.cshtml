@{
    Layout = null;
    ViewData["Title"] = "Square to Fourth";

    var clientSetupUrl = ViewData["ClientSetupUrl"]?.ToString() ?? "/ClientSetup";
    var adminLoginUrl = ViewData["AdminLoginUrl"]?.ToString() ?? "/Identity/Account/Login?returnUrl=%2FClientSetup";
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Secure Square to Fourth sales integration setup." />
    <title>@ViewData["Title"]</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600;9..40,700&display=swap" rel="stylesheet" />
    <style>
        :root {
            --ink: #16211d;
            --muted: #65736c;
            --line: rgba(22, 33, 29, 0.13);
            --paper: rgba(255, 255, 252, 0.82);
            --mint: #d9eee3;
            --green: #126a50;
            --orange: #d96831;
            --shadow: 0 28px 70px rgba(30, 62, 49, 0.14);
        }

        * { box-sizing: border-box; }

        body {
            min-height: 100vh;
            margin: 0;
            color: var(--ink);
            font-family: "DM Sans", sans-serif;
            background:
                radial-gradient(circle at 8% 5%, rgba(217, 238, 227, 0.96), transparent 28rem),
                radial-gradient(circle at 94% 22%, rgba(249, 214, 177, 0.68), transparent 26rem),
                #f6f4ec;
        }

        .shell { width: min(1140px, calc(100% - 40px)); margin: 0 auto; padding: 26px 0 42px; }

        .topbar { display: flex; justify-content: space-between; align-items: center; gap: 20px; }

        .identity, .logos, .platform { display: flex; align-items: center; }
        .identity { gap: 12px; font-weight: 700; letter-spacing: -0.03em; }
        .logos { gap: 7px; }
        .logo { width: 30px; height: 30px; display: grid; place-items: center; border-radius: 9px; color: white; font: 500 10px "DM Mono", monospace; }
        .square { background: #111; }
        .fourth { background: var(--orange); }
        .arrow { color: var(--muted); font: 500 14px "DM Mono", monospace; }
        .platform { gap: 8px; color: var(--muted); font-size: 0.86rem; }
        .dot { width: 8px; height: 8px; border-radius: 50%; background: #48a977; box-shadow: 0 0 0 4px rgba(72, 169, 119, 0.14); }

        main { display: grid; grid-template-columns: minmax(0, 1.16fr) minmax(340px, 0.84fr); gap: 28px; align-items: stretch; margin-top: 68px; }

        .intro { padding: 30px 20px 20px 0; animation: rise 500ms ease-out both; }
        .eyebrow { margin: 0 0 16px; color: var(--green); font: 500 0.76rem "DM Mono", monospace; letter-spacing: 0.1em; text-transform: uppercase; }
        h1 { max-width: 710px; margin: 0; font-size: clamp(3rem, 6.5vw, 5.85rem); line-height: 0.94; letter-spacing: -0.07em; }
        .lede { max-width: 620px; margin: 24px 0 0; color: var(--muted); font-size: 1.13rem; line-height: 1.65; }

        .actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 31px; }
        .button { display: inline-flex; align-items: center; justify-content: center; min-height: 52px; padding: 0 21px; border: 1px solid transparent; border-radius: 14px; font-weight: 700; text-decoration: none; transition: transform 140ms ease, box-shadow 140ms ease, background 140ms ease; }
        .button:hover { transform: translateY(-2px); }
        .button-primary { background: var(--green); box-shadow: 0 12px 24px rgba(18, 106, 80, 0.2); color: #fff; }
        .button-primary:hover { color: #fff; background: #0b573f; }
        .button-secondary { border-color: var(--line); background: rgba(255, 255, 255, 0.46); color: var(--ink); }

        .access-note { margin: 16px 0 0; color: var(--muted); font-size: 0.9rem; }
        .button:focus-visible { outline: 3px solid rgba(18, 106, 80, 0.32); outline-offset: 3px; }

        .flow-card { position: relative; overflow: hidden; padding: 29px; border: 1px solid var(--line); border-radius: 25px; background: var(--paper); box-shadow: var(--shadow); animation: rise 500ms 100ms ease-out both; }
        .flow-card::after { position: absolute; top: -90px; right: -80px; width: 220px; height: 220px; border: 1px solid rgba(18, 106, 80, 0.1); border-radius: 50%; content: ""; }
        .card-label { position: relative; margin: 0; color: var(--green); font: 500 0.75rem "DM Mono", monospace; letter-spacing: 0.1em; text-transform: uppercase; }
        .flow-card h2 { position: relative; margin: 16px 0 25px; font-size: 1.55rem; letter-spacing: -0.045em; }
        .step { position: relative; display: grid; grid-template-columns: 32px 1fr; gap: 13px; padding: 15px 0; border-top: 1px solid var(--line); }
        .step-number { width: 27px; height: 27px; display: grid; place-items: center; border-radius: 50%; background: var(--mint); color: var(--green); font: 500 0.7rem "DM Mono", monospace; }
        .step strong { display: block; font-size: 0.96rem; }
        .step p { margin: 4px 0 0; color: var(--muted); font-size: 0.88rem; line-height: 1.45; }
        .security { position: relative; margin-top: 19px; padding: 15px; border-radius: 14px; background: #f0f8f4; color: #36584b; font-size: 0.87rem; line-height: 1.5; }
        .security strong { color: var(--green); }

        .handoff { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; margin-top: 43px; border: 1px solid var(--line); border-radius: 18px; overflow: hidden; background: var(--line); animation: rise 500ms 180ms ease-out both; }
        .handoff-item { min-height: 132px; padding: 20px; background: rgba(255, 255, 252, 0.62); }
        .handoff-item span { display: block; color: var(--green); font: 500 0.7rem "DM Mono", monospace; letter-spacing: 0.09em; text-transform: uppercase; }
        .handoff-item strong { display: block; margin-top: 10px; font-size: 1rem; letter-spacing: -0.025em; }
        .handoff-item p { margin: 6px 0 0; color: var(--muted); font-size: 0.86rem; line-height: 1.45; }

        .footer { display: flex; justify-content: space-between; gap: 20px; margin-top: 55px; color: var(--muted); font: 0.75rem "DM Mono", monospace; }

        @@keyframes rise { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: translateY(0); } }

        @@media (max-width: 820px) {
            .shell { width: min(100% - 28px, 680px); padding-top: 19px; }
            .platform { display: none; }
            main { grid-template-columns: 1fr; margin-top: 34px; }
            .intro { padding: 10px 0; }
            .flow-card { padding: 23px; }
            .handoff { grid-template-columns: 1fr; }
            .footer { margin-top: 34px; flex-direction: column; }
        }

        @@media (max-width: 460px) {
            h1 { font-size: 3.2rem; }
            .button { width: 100%; }
        }

        @@media (prefers-reduced-motion: reduce) {
            *, *::before, *::after { animation-duration: 1ms !important; transition-duration: 1ms !important; }
        }
    </style>
</head>
<body>
    <div class="shell">
        <header class="topbar">
            <div class="identity">
                <div class="logos" aria-hidden="true">
                    <span class="logo square">SQ</span><span class="arrow">+</span><span class="logo fourth">4TH</span>
                </div>
                <span>Square to Fourth</span>
            </div>
            <div class="platform"><span class="dot" aria-hidden="true"></span>Integration control</div>
        </header>

        <main>
            <section class="intro">
                <p class="eyebrow">Sales integration setup</p>
                <h1>Connect Square. Keep Fourth running.</h1>
                <p class="lede">A controlled bridge for the temporary overlap period. Authorised staff can connect a Square account, map locations, and validate the daily sales file before it reaches Fourth.</p>
                <div class="actions">
                    @if (isAuthenticated)
                    {
                        <a class="button button-primary" href="@clientSetupUrl">Continue to client setup</a>
                    }
                    else
                    {
                        <a class="button button-primary" href="@adminLoginUrl">Sign in to start setup</a>
                    }
                    <a class="button button-secondary" href="#connection-flow">How the connection works</a>
                </div>
                <p class="access-note">
                    @if (isAuthenticated)
                    {
                        <text>You are signed in. Select the client first, then connect Square from its setup card.</text>
                    }
                    else
                    {
                        <text>Admin access is required to select the client and begin a Square connection.</text>
                    }
                </p>
            </section>

            <aside id="connection-flow" class="flow-card" aria-label="Setup flow">
                <p class="card-label">The connection flow</p>
                <h2>Three steps. No Square password stored here.</h2>
                <div class="step">
                    <span class="step-number">01</span>
                    <div><strong>Open the client</strong><p>Choose the correct brand in the protected Client Setup area.</p></div>
                </div>
                <div class="step">
                    <span class="step-number">02</span>
                    <div><strong>Connect in Square</strong><p>Square opens its own sign-in and approval screen for the account owner.</p></div>
                </div>
                <div class="step">
                    <span class="step-number">03</span>
                    <div><strong>Verify and map</strong><p>Return to the dashboard, verify the connection, then map Square locations to Fourth.</p></div>
                </div>
                <div class="security"><strong>What the client needs:</strong> their normal Square login and permission to approve the connection. The integration stores Square tokens, not the client's password.</div>
            </aside>
        </main>

        <section class="handoff" aria-label="Connection responsibilities">
            <div class="handoff-item">
                <span>Integration admin</span>
                <strong>Starts the connection</strong>
                <p>Signs in here, selects the correct client, and opens the Square connection from Client Setup.</p>
            </div>
            <div class="handoff-item">
                <span>Square account owner</span>
                <strong>Approves in Square</strong>
                <p>Uses their normal Square sign-in on Square's own page and approves the requested access.</p>
            </div>
            <div class="handoff-item">
                <span>Integration</span>
                <strong>Stores the tokens</strong>
                <p>Receives renewable OAuth tokens for the selected client. It never receives a Square password.</p>
            </div>
        </section>

        <footer class="footer">
            <span>squaretofourth.store</span>
            <span>Temporary Square to Fourth sales bridge</span>
        </footer>
    </div>
</body>
</html>
