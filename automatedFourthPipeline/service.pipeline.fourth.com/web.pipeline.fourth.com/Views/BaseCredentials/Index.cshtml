@model IEnumerable<data.pipeline.fourth.com.Models.Credentials.BaseCredential>
@{
    ViewData["Title"] = "API Credentials";
}

<div class="page-header">
    <div><h1>API credentials</h1><p class="text-muted mb-0">Stored connection records. Token values are intentionally never displayed in the control panel.</p></div>
    <a class="btn btn-outline-primary" asp-action="Create"><i class="mdi mdi-plus mr-1"></i>Add credential</a>
</div>
<section class="card sf-panel">
    @if (!Model.Any())
    {
        <div class="sf-empty"><i class="mdi mdi-key-variant" aria-hidden="true"></i><h2>No credentials stored</h2><p>Square OAuth credentials are created when a client completes the Square connection flow.</p><a class="btn btn-dark" asp-controller="ClientSetup" asp-action="Index">Open client setup</a></div>
    }
    else
    {
        <div class="sf-table-wrap"><table class="table table-hover"><thead><tr><th>Connection</th><th>Client</th><th>Store</th><th>Endpoint</th><th>Token state</th><th>Status</th><th></th></tr></thead><tbody>
        @foreach (var item in Model)
        {
            var hasAccessToken = !string.IsNullOrWhiteSpace(item.LatestAccessToken);
            var hasRefreshToken = !string.IsNullOrWhiteSpace(item.RefreshToken);
            <tr><td><strong>@item.CredentialType</strong><br /><small class="text-muted">@item.Username</small></td><td>@item.Brand?.Name</td><td>@item.Store?.Name</td><td><code>@item.BaseEndpoint</code></td><td><span class="sf-status @(hasAccessToken && hasRefreshToken ? "sf-status-live" : "sf-status-warn")">@(hasAccessToken && hasRefreshToken ? "Renewable token" : "Needs attention")</span></td><td><span class="sf-status @(item.Active ? "sf-status-live" : "sf-status-muted")">@(item.Active ? "Active" : "Inactive")</span></td><td><div class="sf-actions"><a class="btn btn-outline-primary btn-sm" asp-action="TestCreds" asp-route-id="@item.Id">Test</a><a class="btn btn-outline-secondary btn-sm" asp-action="Edit" asp-route-id="@item.Id">Edit</a><a class="btn btn-outline-danger btn-sm" asp-action="Delete" asp-route-id="@item.Id">Delete</a></div></td></tr>
        }
        </tbody></table></div>
    }
</section>
