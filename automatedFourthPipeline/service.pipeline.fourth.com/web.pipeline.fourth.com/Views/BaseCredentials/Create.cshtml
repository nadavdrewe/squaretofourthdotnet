@model data.pipeline.fourth.com.Models.Credentials.BaseCredential
@{
    ViewData["Title"] = "Add API Credential";
}

<div class="page-header"><div><h1>Add API credential</h1><p class="text-muted mb-0">Add a Fourth or legacy connection credential. Square connections are created only through the protected Square OAuth flow.</p></div><a class="btn btn-outline-secondary" asp-action="Index">Back to credentials</a></div>
<div class="row"><div class="col-lg-8"><section class="card"><div class="card-body">
    <div class="howto-note"><i class="mdi mdi-shield-key-outline"></i><div><strong>Square OAuth is managed automatically.</strong><br />Use Client Setup to connect Square. This form intentionally does not create or accept Square access or refresh tokens.</div></div>
    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <div class="row"><div class="col-md-6"><div class="form-group"><label asp-for="BrandId">Client</label><select asp-for="BrandId" class="form-control" asp-items="ViewBag.BrandId"><option value="">Select client</option></select></div></div><div class="col-md-6"><div class="form-group"><label asp-for="StoreId">Store (optional)</label><select asp-for="StoreId" class="form-control" asp-items="ViewBag.StoreId"><option value="">Client-level credential</option></select></div></div></div>
        <div class="form-group"><label asp-for="CredentialType">Connection type</label><select asp-for="CredentialType" asp-items="ViewBag.CredentialType" class="form-control"></select><span asp-validation-for="CredentialType" class="text-danger"></span></div>
        <div class="row"><div class="col-md-6"><div class="form-group"><label asp-for="Username">Username</label><input asp-for="Username" class="form-control" autocomplete="off" /><span asp-validation-for="Username" class="text-danger"></span></div></div><div class="col-md-6"><div class="form-group"><label asp-for="Password">Password</label><input asp-for="Password" class="form-control" type="password" autocomplete="new-password" /><span asp-validation-for="Password" class="text-danger"></span></div></div></div>
        <div class="form-group"><label asp-for="BaseEndpoint">API base URL</label><input asp-for="BaseEndpoint" class="form-control" placeholder="https://..." /><span asp-validation-for="BaseEndpoint" class="text-danger"></span></div>
        <div class="row"><div class="col-md-6"><div class="form-group"><label asp-for="ClientId">OAuth client ID (optional)</label><input asp-for="ClientId" class="form-control" autocomplete="off" /></div></div><div class="col-md-6"><div class="form-group"><label asp-for="ClientSecret">OAuth client secret (optional)</label><input asp-for="ClientSecret" class="form-control" type="password" autocomplete="new-password" /></div></div></div>
        <div class="row"><div class="col-md-6"><div class="form-group"><label asp-for="SupplimentalData1">OAuth token endpoint (optional)</label><input asp-for="SupplimentalData1" class="form-control" placeholder="https://.../token" /></div></div><div class="col-md-6"><div class="form-group"><label asp-for="SupplimentalData2">OAuth scope (optional)</label><input asp-for="SupplimentalData2" class="form-control" /></div></div></div>
        <div class="form-group"><label asp-for="KeySecret">Additional secret (optional)</label><input asp-for="KeySecret" class="form-control" type="password" autocomplete="new-password" /></div>
        <div class="form-check mb-4"><input asp-for="Active" class="form-check-input" /><label asp-for="Active" class="form-check-label">Make this credential active</label></div>
        <button type="submit" class="btn btn-primary">Save credential</button><a class="btn btn-light" asp-action="Index">Cancel</a>
    </form>
</div></section></div></div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
