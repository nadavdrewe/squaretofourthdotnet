@model data.pipeline.fourth.com.Models.Credentials.BaseCredential
@{
    ViewData["Title"] = "Delete API Credential";
    var isSquareOAuth = Model.CredentialType == shared.pipeline.fouth.com.Enums.CredentialTypes.SquareApi;
}

<div class="page-header"><div><h1>Delete API credential</h1><p class="text-muted mb-0">This immediately removes the stored connection material for this record.</p></div></div>
<section class="card sf-danger-panel"><div class="card-body"><h2>Remove this credential?</h2><p>@Model.CredentialType for <strong>@(Model.Brand?.Name ?? "unassigned client")</strong>@(Model.Store == null ? "" : " / " + Model.Store.Name).</p>
@if (isSquareOAuth) { <div class="alert alert-warning">Deleting this OAuth connection stops Square token refresh and sales collection for the client until Square is connected again.</div> }
<dl class="row sf-definition-list"><dt class="col-md-3">API base URL</dt><dd class="col-md-9"><code>@Model.BaseEndpoint</code></dd><dt class="col-md-3">Status</dt><dd class="col-md-9">@(Model.Active ? "Active" : "Inactive")</dd></dl>
<form asp-action="Delete" method="post"><input asp-for="Id" type="hidden" /><button type="submit" class="btn btn-danger">Delete credential</button><a class="btn btn-light" asp-action="Index">Cancel</a></form>
</div></section>
