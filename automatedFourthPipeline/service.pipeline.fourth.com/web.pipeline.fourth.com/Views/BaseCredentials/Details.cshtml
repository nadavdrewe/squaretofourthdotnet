@model data.pipeline.fourth.com.Models.Credentials.BaseCredential
@{
    ViewData["Title"] = "API Credential Details";
    var isSquareOAuth = Model.CredentialType == shared.pipeline.fouth.com.Enums.CredentialTypes.SquareApi;
}

<div class="page-header"><div><h1>API credential details</h1><p class="text-muted mb-0">Configuration summary only. Secret material is never shown.</p></div><div class="sf-actions"><a class="btn btn-outline-primary" asp-action="TestCreds" asp-route-id="@Model.Id">Test connection</a><a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Edit</a></div></div>
<section class="card"><div class="card-body"><dl class="row sf-definition-list">
    <dt class="col-md-3">Connection type</dt><dd class="col-md-9">@Model.CredentialType @(isSquareOAuth ? "(OAuth managed)" : "")</dd>
    <dt class="col-md-3">Client</dt><dd class="col-md-9">@(Model.Brand?.Name ?? "Not assigned")</dd>
    <dt class="col-md-3">Store</dt><dd class="col-md-9">@(Model.Store?.Name ?? "Client-level")</dd>
    <dt class="col-md-3">Username</dt><dd class="col-md-9">@Model.Username</dd>
    <dt class="col-md-3">API base URL</dt><dd class="col-md-9"><code>@Model.BaseEndpoint</code></dd>
    <dt class="col-md-3">Secrets</dt><dd class="col-md-9"><span class="sf-status @(HasStoredSecret() ? "sf-status-live" : "sf-status-muted")">@(HasStoredSecret() ? "Stored" : "None")</span></dd>
    <dt class="col-md-3">Token state</dt><dd class="col-md-9"><span class="sf-status @(!string.IsNullOrWhiteSpace(Model.LatestAccessToken) ? "sf-status-live" : "sf-status-warn")">@(!string.IsNullOrWhiteSpace(Model.LatestAccessToken) ? "Access token stored" : "No access token")</span></dd>
    <dt class="col-md-3">Status</dt><dd class="col-md-9"><span class="sf-status @(Model.Active ? "sf-status-live" : "sf-status-muted")">@(Model.Active ? "Active" : "Inactive")</span></dd>
    <dt class="col-md-3">Last updated</dt><dd class="col-md-9">@Model.WhenUpdatedUTC.ToString("yyyy-MM-dd HH:mm") UTC</dd>
</dl></div></section>
<div class="mt-3"><a class="btn btn-light" asp-action="Index">Back to credentials</a></div>

@functions {
    private bool HasStoredSecret() => !string.IsNullOrWhiteSpace(Model.ClientSecret) || !string.IsNullOrWhiteSpace(Model.Password) || !string.IsNullOrWhiteSpace(Model.KeySecret) || !string.IsNullOrWhiteSpace(Model.RefreshToken);
}
