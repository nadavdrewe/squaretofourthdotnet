@model web.pipeline.fourth.com.Models.PublicOnboardingInputModel
@{ Layout = "_OnboardingLayout"; ViewData["Title"] = "Customer details"; }
<h1>Set up your Square integration</h1>
<p>The invitation phrase is valid. Enter the customer details below; you will connect the Square seller account after access is created.</p>
<form asp-action="Index" method="post" class="mt-4" style="max-width:520px">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input asp-for="SetupKey" type="hidden" />
    <label asp-for="ClientName">Business or customer name</label><input asp-for="ClientName" class="form-control" autocomplete="organization" autofocus /><span asp-validation-for="ClientName" class="text-danger"></span>
    <label asp-for="Email" class="mt-3">Owner email</label><input asp-for="Email" class="form-control" type="email" autocomplete="email" /><span asp-validation-for="Email" class="text-danger"></span>
    <button class="btn btn-primary mt-4" type="submit">Create integration access</button>
    <a class="btn btn-link mt-4" asp-action="Index">Use a different phrase</a>
</form>
