<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <title>@ViewData["Title"] - Square to Fourth</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600;9..40,700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/template/vendors/mdi/css/materialdesignicons.min.css" />
    <link rel="stylesheet" href="~/template/vendors/css/vendor.bundle.base.css" />
    <link rel="stylesheet" href="~/template/vendors/datatables.net-bs4/dataTables.bootstrap4.css" />
    <link rel="stylesheet" href="~/template/css/vertical-layout-dark/style.css" />
    <link rel="stylesheet" href="~/css/square-fourth.css" asp-append-version="true" />
</head>
<body>
    <a class="sf-skip-link" href="#main-content">Skip to content</a>
    <div class="container-scroller">
        <nav class="navbar col-lg-12 col-12 p-0 fixed-top d-flex flex-row" aria-label="Application header">
            <div class="text-center navbar-brand-wrapper d-flex align-items-center">
                <a class="navbar-brand brand-logo square-fourth-brand" asp-controller="Home" asp-action="Index" aria-label="Square to Fourth home">
                    <span class="sf-marks" aria-hidden="true"><span class="sf-mark sf-square">SQ</span><span class="sf-plus">+</span><span class="sf-mark sf-fourth">4TH</span></span>
                    <span class="sf-brand-copy"><strong>Square to Fourth</strong><small>Integration control</small></span>
                </a>
                <a class="navbar-brand brand-logo-mini square-fourth-brand-mini" asp-controller="Home" asp-action="Index" aria-label="Square to Fourth home"><span class="sf-mark sf-square">SQ</span></a>
            </div>
            <div class="navbar-menu-wrapper d-flex align-items-center justify-content-end">
                <button class="navbar-toggler align-self-center" type="button" data-toggle="minimize" aria-label="Minimise navigation">
                    <span class="mdi mdi-menu"></span>
                </button>
                <div class="navbar-context d-none d-lg-flex">Square sales to Fourth</div>
                <div class="square-fourth-access"><partial name="_LoginPartial" /></div>
                <button class="navbar-toggler navbar-toggler-right d-lg-none align-self-center" type="button" data-toggle="offcanvas" aria-label="Open navigation">
                    <span class="mdi mdi-menu"></span>
                </button>
            </div>
        </nav>

        <div class="container-fluid page-body-wrapper">
            <nav class="sidebar sidebar-offcanvas" id="sidebar" aria-label="Main navigation">
                <ul class="nav">
                    <li class="nav-item sf-nav-label"><span>Workspace</span></li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Index"><i class="mdi mdi-view-dashboard-outline menu-icon"></i><span class="menu-title">Overview</span></a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="ClientSetup" asp-action="Index"><i class="mdi mdi-account-multiple menu-icon"></i><span class="menu-title">Client Setup</span></a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="HowTo" asp-action="Index"><i class="mdi mdi-book-open-page-variant menu-icon"></i><span class="menu-title">Setup Guide</span></a>
                    </li>

                    <li class="nav-item sf-nav-label"><span>Configuration</span></li>
                    <li class="nav-item">
                        <a class="nav-link" data-toggle="collapse" href="#client-config" aria-expanded="false" aria-controls="client-config"><i class="mdi mdi-domain menu-icon"></i><span class="menu-title">Clients</span><i class="menu-arrow"></i></a>
                        <div class="collapse" id="client-config">
                            <ul class="nav flex-column sub-menu">
                                <li class="nav-item"><a class="nav-link" asp-controller="Brands" asp-action="Index">All clients</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="Brands" asp-action="Create">Add client</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="Stores" asp-action="Index">Stores</a></li>
                            </ul>
                        </div>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" data-toggle="collapse" href="#square-config" aria-expanded="false" aria-controls="square-config"><i class="mdi mdi-square-outline menu-icon"></i><span class="menu-title">Square</span><i class="menu-arrow"></i></a>
                        <div class="collapse" id="square-config">
                            <ul class="nav flex-column sub-menu">
                                <li class="nav-item"><a class="nav-link" asp-controller="SquareOAuthApplications" asp-action="Index">OAuth applications</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="SquareStoreConfigs" asp-action="Index">Location mappings</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="SquareEmployeeMappings" asp-action="Index">Team member mappings</a></li>
                            </ul>
                        </div>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" data-toggle="collapse" href="#fourth-config" aria-expanded="false" aria-controls="fourth-config"><i class="mdi mdi-file-delimited menu-icon"></i><span class="menu-title">Fourth</span><i class="menu-arrow"></i></a>
                        <div class="collapse" id="fourth-config">
                            <ul class="nav flex-column sub-menu">
                                <li class="nav-item"><a class="nav-link" asp-controller="FourthSalesApiStoreConfigs" asp-action="Index">Sales mappings</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="BrandIntegrations" asp-action="Index">Integration schedules</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="BaseCredentials" asp-action="Index">API credentials</a></li>
                            </ul>
                        </div>
                    </li>

                    <li class="nav-item sf-nav-label"><span>Operations</span></li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="PipelineRunRecords" asp-action="Index"><i class="mdi mdi-history menu-icon"></i><span class="menu-title">Pipeline Runs</span></a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="PipelineEventLogs" asp-action="Index"><i class="mdi mdi-text-box-search-outline menu-icon"></i><span class="menu-title">Event Logs</span></a>
                    </li>
                </ul>
            </nav>

            <main id="main-content" class="main-panel">
                <div class="content-wrapper">
                    @RenderBody()
                </div>
                <footer class="footer">
                    <div class="d-sm-flex justify-content-center justify-content-sm-between">
                        <span class="text-muted text-center text-sm-left d-block d-sm-inline-block">Square to Fourth integration control</span>
                        <span class="float-none float-sm-right d-block mt-1 mt-sm-0 text-center">Square sales data, delivered to Fourth</span>
                    </div>
                </footer>
            </main>
        </div>
    </div>

    <script src="~/template/vendors/js/vendor.bundle.base.js"></script>
    <script src="~/template/js/off-canvas.js"></script>
    <script src="~/template/js/hoverable-collapse.js"></script>
    <script src="~/template/js/template.js"></script>
    <script src="~/template/vendors/datatables.net/jquery.dataTables.js"></script>
    <script src="~/template/vendors/datatables.net-bs4/dataTables.bootstrap4.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
