@if (User.Identity?.IsAuthenticated == true)
{
    <span class="nav-link square-fourth-user">@User.Identity.Name</span>
    <form class="form-inline" asp-controller="Access" asp-action="Logout" method="post">
        <button type="submit" class="nav-link btn btn-link text-dark">Logout</button>
    </form>
}
else
{
    <a class="nav-link text-dark" asp-controller="Access" asp-action="Login">Admin login</a>
}
