<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
<title>@ViewData["Title"] - Square Integration</title>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
<style>
*{box-sizing:border-box}html,body{min-height:100%;margin:0}body{padding:0!important;color:#000;background:#f7f7f7;font-family:"DM Sans",Arial,sans-serif}.public-header{position:relative;inset:auto;z-index:1;width:100%;height:76px;margin:0;display:flex;align-items:center;border:0;border-bottom:1px solid #dedede;background:#fff;box-shadow:none}.public-header-inner{width:min(1120px,calc(100% - 40px));margin:0 auto;display:flex;align-items:center;justify-content:space-between;gap:24px}.public-badge{display:block;width:126px;max-width:40vw;height:auto}.public-label{color:#555;font-size:13px;font-weight:600;letter-spacing:.01em}.public-main{position:static;width:min(760px,calc(100% - 36px));margin:0 auto;padding:64px 0}.public-card{padding:42px;border:1px solid #ddd;border-radius:16px;background:#fff;box-shadow:0 10px 30px rgba(0,0,0,.05)}h1{margin:0 0 16px;font-size:clamp(2rem,6vw,3.5rem);line-height:1;letter-spacing:-.055em}p{margin:0 0 16px;color:#606060;line-height:1.6}.form-control{display:block;width:100%;min-height:50px;padding:11px 13px;color:#000;background:#fff;border:1px solid #aaa;border-radius:9px;font:inherit}.form-control:focus{outline:0;border-color:#000;box-shadow:0 0 0 3px rgba(0,0,0,.1)}label{display:block;margin:22px 0 7px;font-weight:700}.btn{display:inline-flex;min-height:48px;padding:0 20px;align-items:center;justify-content:center;border:1px solid transparent;border-radius:9px;background:transparent;color:#000;font:inherit;font-weight:700;text-decoration:none;cursor:pointer}.btn-primary{border-color:#000;background:#000;color:#fff}.btn-primary:hover{border-color:#222;background:#222}.btn-outline-secondary{border-color:#aaa;background:#fff}.btn-link{padding-right:8px;padding-left:8px;color:#000;text-decoration:underline}.alert{margin:20px 0;padding:16px;border:1px solid #ccc;border-radius:10px;background:#f3f3f3;line-height:1.55}.alert-warning{border-color:#d5b45d;background:#fff8e5}.text-danger{display:block;margin-top:6px;color:#b42318}.validation-summary-valid{display:none}.mt-3{margin-top:16px!important}.mt-4{margin-top:24px!important}.ms-2{margin-left:8px!important}code{font-size:1.05em}@@media(max-width:600px){.public-header{height:68px}.public-header-inner{width:calc(100% - 32px)}.public-main{padding:32px 0}.public-card{padding:28px 22px}.public-label{display:none}.btn{width:100%;margin-left:0!important}.btn+.btn{margin-top:10px!important}}
</style></head><body>
<header class="public-header"><div class="public-header-inner"><img class="public-badge" src="https://images.ctfassets.net/1nw4q0oohfju/7ntgEwkWoRRGdTu91jr9yd/62d9d5b8a06107447c15cbbfffd2abb7/brand_black-f67a0600187e707deb22521e86452dd6746851870f815e9e454423b9e5b8a6d3.png" alt="Built with Square" /><span class="public-label">Square seller onboarding</span></div></header>
<main class="public-main"><section class="public-card">@RenderBody()</section></main>
<partial name="_ValidationScriptsPartial" />
</body></html>
