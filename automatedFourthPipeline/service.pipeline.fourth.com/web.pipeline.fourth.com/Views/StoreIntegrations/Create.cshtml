@model data.pipeline.fourth.com.Models.StoreIntegration

@{
    ViewData["Title"] = "Create";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Create</h1>

<h4>Store Integration</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="StoreId" class="control-label">Which Store?</label>
                <select asp-for="StoreId" class="form-control" asp-items="ViewBag.StoreId"></select>
            </div>
            <div class="form-group">
                <label asp-for="IntegrationType" class="control-label">Integration Type</label>
                <select asp-for="IntegrationType" asp-items="Html.GetEnumSelectList<shared.pipeline.fourth.com.IntegrationTypes>()" class="form-control"></select>
                <span asp-validation-for="IntegrationType" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="IntegrationSubType" class="control-label">Integration Sub Type</label>
                <select asp-for="IntegrationSubType" asp-items="Html.GetEnumSelectList<shared.pipeline.fourth.com.IntegrationSubTypes>()" class="form-control"></select>
                <span asp-validation-for="IntegrationSubType" class="text-danger"></span>
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="Active" /> @Html.DisplayNameFor(model => model.Active)
                </label>
            </div>

            @*<div class="form-group">
                    <label asp-for="WhenCreatedUTC" class="control-label"></label>
                    <input asp-for="WhenCreatedUTC" class="form-control" />
                    <span asp-validation-for="WhenCreatedUTC" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="WhenUpdatedUTC" class="control-label"></label>
                    <input asp-for="WhenUpdatedUTC" class="form-control" />
                    <span asp-validation-for="WhenUpdatedUTC" class="text-danger"></span>
                </div>*@

            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
