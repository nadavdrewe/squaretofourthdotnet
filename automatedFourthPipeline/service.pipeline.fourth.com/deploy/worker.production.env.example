# Replace every placeholder in the deployment platform's secret store. Do not commit the real file.
DOTNET_ENVIRONMENT=Production
ConnectionStrings__FourthSalesPipelineContext=Server=YOUR_SQL_HOST;Database=FourthSalesPipelineContext;User ID=YOUR_USER;Password=YOUR_PASSWORD;TrustServerCertificate=True
SquareToFourthSales__CronExpression=0 0 11 * * ?
SquareToFourthSales__CsvOutputDirectory=/var/lib/square-to-fourth/sales
SquareToFourthSales__UploadToFourth=false
SquareToFourthSales__RunOnStartup=false
SquareToFourthTimesheets__XmlOutputDirectory=/var/lib/square-to-fourth/timesheets
SquareToFourthTimesheets__UploadToFourth=false
PipelineAlerts__Enabled=false
