# Replace every placeholder in the deployment platform's secret store. Do not commit the real file.
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080
ConnectionStrings__DefaultConnection=Server=YOUR_SQL_HOST;Database=FourthSalesPipelineContextAuth;User ID=YOUR_USER;Password=YOUR_PASSWORD;TrustServerCertificate=True
ConnectionStrings__FourthSalesPipelineContext=Server=YOUR_SQL_HOST;Database=FourthSalesPipelineContext;User ID=YOUR_USER;Password=YOUR_PASSWORD;TrustServerCertificate=True
StaticAdmin__Username=admin
StaticAdmin__PasswordHash=SHA256_HEX_OF_A_UNIQUE_LONG_PASSWORD
DataProtection__KeysDirectory=/var/lib/square-to-fourth/keys
ForwardedHeaders__Enabled=true
