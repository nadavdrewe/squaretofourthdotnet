@using web.fourth.revel.com.Classes.Utility
@using System.Collections.Generic;
@using Revel._808nd.com.Classes


@{

    var logs = (List<ScheduledTaskLog>)HttpRuntime.Cache.Get("logs");
    var yesterdayLogs = (List<ScheduledTaskLog>)HttpRuntime.Cache.Get("yesterdayLogs");


    var localPath = "assets\\img\\logo";
    var webPath = "/assets/img/logo/";

    var imageLocation = AppDomain.CurrentDomain.GetData("APPBASE").ToString() + localPath;

    var randomImageArray = @Utility.GetRandomImage(imageLocation).Split('\\');
    var imagefileName = randomImageArray[randomImageArray.Count() - 1];

    var avatarURL = webPath + imagefileName;

}



